{
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "rimraf rider/.observablehq/cache hub/.observablehq/cache",
    "build": "npm run build:rider && npm run build:hub",
    "build:rider": "observable build -c rider.config.js",
    "build:hub": "observable build -c hub.config.js",
    "dev": "npm run dev:rider",
    "dev:rider": "observable preview -c rider.config.js --host=localhost --port=3001",
    "dev:hub": "observable preview -c hub.config.js --host=localhost --port=3002",
    "observable": "observable"
  },
  "dependencies": {
    "@observablehq/framework": "^1.13.4",
    "d3-dsv": "^3.0.1",
    "d3-time-format": "^4.1.0",
    "playwright": "^1.56.1"
  },
  "devDependencies": {
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}
