# Wind stations in the order !conditions lists them (any others after).
WIND_ORDER = ["kihei", "wailea", "hookipa"]
SITE_NAMES = {"kihei": "Kihei", "wailea": "Wailea", "hookipa": "Ho'okipa", "pauwela": "Pauwela",
              "kanaha": "Kanaha"}


def site_name(site):
    return SITE_NAMES.get(site, site.replace("_", " ").title())


def hst(epoch):
    return datetime.fromtimestamp(epoch, HST)


def when(epoch):
    """"18:52" today in Hawaii, "Sun 18:52" otherwise."""
    t = hst(epoch)
    return f"{t:%H:%M}" if t.date() == datetime.now(HST).date() else f"{t:%a %H:%M}"


WEATHER = None  # a Weather once main starts it: live readings over MQTT
LIVE_KEY = "live/wind.json"  # outside publish's prefixes, so orphans leaves it be
LIVE_EVERY = 30  # at most one write of it per this many seconds
LIVE_HEADERS = ["Content-Encoding: gzip", "Content-Type: application/json",
                "Cache-Control: public, max-age=30"]


def seed_weather(weather):
    """The lake's last day of wind under the live feed, so a restart
    doesn't start the live object over empty."""
    by = {}
    for r in query("select site, epoch(ts) as t, wavg, wdir, wgust, wlull from wind "
                   "where ts > now() - interval 1 day and wavg is not null order by ts"):
        by.setdefault(r.pop("site"), []).append(r)
    for site, rows in by.items():
        weather.seed(site, rows)
    log(f"seeded live wind from the lake: {', '.join(f'{s} {len(r)}' for s, r in by.items())}")


def write_live(weather, dry_run=False):
    """Keep LIVE_KEY in the bucket replaced with weather's last 24 hours,
    within LIVE_EVERY seconds of each new reading. Runs in its own thread."""
    while True:
        weather.changed.wait()
        weather.changed.clear()
        body = gzip.compress(json.dumps(weather.snapshot(), separators=(",", ":")).encode(),
                             mtime=0)
        args = ["rclone", "rcat", dwp_publish.DEST + LIVE_KEY]
        for h in LIVE_HEADERS:
            args += ["--header-upload", h]
        if dry_run:
            log(f"would write {LIVE_KEY}: {len(body)} bytes")
        else:
            r = subprocess.run(args, input=body, capture_output=True)
            if r.returncode != 0:
                log(f"writing {LIVE_KEY} failed: {r.stderr.decode(errors='replace').strip()}")
        time.sleep(LIVE_EVERY)


def wind_now():
    """Per station with readings in the last day: (site, latest reading,
    its average an hour earlier), in WIND_ORDER. The lake's readings, then
    the live feed's newer ones on top."""
    rows = query("select site, epoch(ts) as t, wavg, wdir, wgust, wlull from wind "
                 "where ts > now() - interval 1 day and wavg is not null order by ts")
    by = {}
    for r in rows:
        by.setdefault(r["site"], []).append(r)
    for site, live in (WEATHER.recent() if WEATHER else {}).items():
        rs = by.setdefault(site, [])
        newest = rs[-1]["t"] if rs else 0
        rs += [r for r in live if r["t"] > newest]
    out = []
    for site, rs in by.items():
        last = rs[-1]
        hour_ago = [r["wavg"] for r in rs if 3000 <= last["t"] - r["t"] <= 4200]
        out.append((site, last, sum(hour_ago) / len(hour_ago) if hour_ago else None))
    return sorted(out, key=lambda x: (WIND_ORDER.index(x[0]) if x[0] in WIND_ORDER
                                      else len(WIND_ORDER), -x[1]["t"]))


def wind_line(site, r, before):
    # "Kīhei 15g20 @350". Gust or direction can be missing (a station's row
    # can lack them); lulls aren't shown.
    s = (f"{site_name(site)} {r['wavg']:.0f}"
         + (f"g{r['wgust']:.0f}" if r.get("wgust") is not None else "")
         + (f" @{r['wdir']:.0f}" if r.get("wdir") is not None else ""))
    if before is not None:
        d = r["wavg"] - before
        s += (f" · building from {before:.0f}" if d >= 3 else
              f" · dropping from {before:.0f}" if d <= -3 else " · steady")
    return s + f" · {'live ' if r.get('live') else ''}{when(r['t'])}"


def tide_line():
    """Kihei's tides today, from the live feed's aux2: "low 09:52 0.6 ft ·
    high 15:24 1.7 ft", the next one marked."""
    ts = tides(WEATHER.info("kihei").get("aux2")) if WEATHER else []
    if not ts:
        return None
    now = time.time()
    nxt = next((t for t, _, _ in ts if t > now), None)
    return "Kihei tide: " + " · ".join(
        f"{'next ' if t == nxt else ''}{'high' if hl == 'H' else 'low'} {hst(t):%H:%M} {ft:.1f} ft"
        for t, hl, ft in ts)


def swells_now():
    """Per buoy with a reading in the last day: (site, epoch, [(ft, s, °, kJ)])
    from swell_partition's latest full reading, rank 1 (NDBC's own) first.
    The spectral components (rank 2+) come with the :56 readings, so a
    newer reading with rank 1 alone loses to the one before it. kJ is the
    Surfline-style figure the web shows: rank 1's surfline_kj for the whole
    reading, and each component's share of it (swellKJShares in
    web/lib/components/spectral-partitions.js); None when there's no total."""
    rows = query("with latest as (select site, arg_max(ts, (n > 1)::int * 1e10 + epoch(ts)) as ts "
                 "from (select site, ts, count(*) as n from swell_partition "
                 "where ts > now() - interval 1 day group by all) group by site) "
                 "select p.site, epoch(p.ts) as t, p.rank, p.height, p.period, p.direction, "
                 "p.energy, p.surfline_kj "
                 "from swell_partition p join latest using (site, ts) order by p.site, p.rank")
    by = {}
    for r in rows:
        if r["height"] and r["period"] and r["direction"] is not None:
            by.setdefault((r["site"], r["t"]), []).append(r)
    out = []
    for (site, t), rs in by.items():
        total = next((r["surfline_kj"] for r in rs if r["rank"] == 1), None)
        parts = [r for r in rs if r["rank"] > 1]
        raw = [(r["energy"] or 0) * G * r["period"] ** 2 / math.pi for r in parts]
        scale = total / sum(raw) if total is not None and sum(raw) > 0 else None
        kj = {id(r): k * scale if scale else None for r, k in zip(parts, raw)}
        out.append((site, t, [(r["height"] * 3.28084, r["period"], r["direction"],
                               total if r["rank"] == 1 else kj[id(r)]) for r in rs]))
    return out


def swell_text(swells, n=3):
    return ", ".join(f"{ft:.1f} ft {per:.0f} s {spectrum_svg.compass(d)}"
                     if per >= 10 else f"{ft:.1f} ft {per:.1f} s {spectrum_svg.compass(d)}"
                     for ft, per, d, _ in swells[:n])


def swell_kj_text(swells, n=4):
    """swell_text with each swell's kJ, as the web's buoy cards show it."""
    return ", ".join(swell_text([sw], 1) + (f" ({sw[3]:.0f} kJ)" if sw[3] is not None else "")
                     for sw in swells[:n])


def spectrum_rows(site, epoch):
    return [(r["freq"], r["energy"], r["direction"]) for r in query(
        f"select freq, energy, direction from swell_spectrum where site = {sql_str(site)} "
        f"and ts = to_timestamp({epoch}) order by freq")]


def nearest_spectrum(site, epoch):
    """The epoch of the buoy's spectrum within an hour of epoch, or None."""
    near = query(f"select epoch(ts) as t from swell_spectrum where site = {sql_str(site)} "
                 f"and ts between to_timestamp({epoch - 3600}) and to_timestamp({epoch + 3600}) "
                 f"order by abs(epoch(ts) - {epoch}) limit 1")
    return near[0]["t"] if near else None


def spectrum_png(site, epoch, swells):
    """PNG bytes of the buoy's spectrum at epoch, with the reading nearest
    six hours before it dashed over it; None if there's no spectrum."""
    epoch = nearest_spectrum(site, epoch)
    if epoch is None:
        return None
    rows = spectrum_rows(site, epoch)
    prev = query(f"select epoch(ts) as t from swell_spectrum where site = {sql_str(site)} "
                 f"and ts between to_timestamp({epoch - 7 * 3600}) and to_timestamp({epoch - 5 * 3600}) "
                 f"order by abs(epoch(ts) - {epoch - 6 * 3600}) limit 1")
    earlier = spectrum_rows(site, prev[0]["t"]) if prev else None
    t = hst(epoch)
    title = f"{site_name(site)} {t:%a %b} {t.day} {t:%H:%M} · {swell_text(swells)}"
    label = f"{hst(prev[0]['t']):%H:%M} (6h earlier)" if prev else ""
    return spectrum_svg.to_png(spectrum_svg.spectrum_svg(rows, title, earlier, label))


def status_line():
    """One line of the latest conditions, for the bot's pinned message."""
    wind = wind_now()
    parts = [f"{site_name(s)} {r['wavg']:.0f}"
             + (f"g{r['wgust']:.0f}" if r.get("wgust") is not None else "") + " kn"
             + (f" {spectrum_svg.compass(r['wdir'])}" if r.get("wdir") is not None else "")
             for s, r, _ in wind]
    parts += [f"{site_name(s)} {swell_text(sw, 2)}"
              + (f" {sw[0][3]:.0f} kJ" if sw[0][3] is not None else "") for s, _, sw in swells_now()]
    if wind:
        parts.append(f"as of {when(max(r['t'] for _, r, _ in wind))}")
    return " · ".join(parts)


def fresh_cam(site="wailea"):
    """The site's cam reading if it's recent and in daylight, else None."""
    cam = WEATHER.cam(site) if WEATHER else None
    if cam and cam["daylight"] and time.time() - cam["t"] < CAM_STALE:
        return cam
    return None


def cam_line(cam, site="wailea"):
    return (f"{site_name(site)} cam: {cam['sea']}"
            + (f", shorebreak {cam['shorebreak']}" if cam["shorebreak"] else "")
            + f" · {when(cam['t'])}")


def motion_line(site="wailea"):
    """The cam's water motion, if there's a recent measurement: right to
    left (dx < 0) is energy running down the coast toward Makena."""
    m = WEATHER.water_motion(site) if WEATHER else None
    if not m or m["dx"] is None or time.time() - m["t"] > CAM_STALE:
        return None
    way = "down the coast" if m["dx"] < 0 else "up the coast"
    share = m["left"] if m["dx"] < 0 else 1 - m["left"]
    caps = f", {m['whitecaps']} whitecaps" if m.get("whitecaps") else ""
    return (f"{site_name(site)} water moving {way}, {abs(m['dx']):.1f} px/s "
            f"({share:.0%}){caps} · {when(m['t'])}")


def send_cam_frame(mx, room, cam, cache, reply_to=None):
    """Post the frame the cam reading was made from, if Node-RED gave its
    URL (fetched from here, so a LAN address is fine); cache maps the
    reading's time to its upload, so it goes up once."""
    if not cam.get("image"):
        return
    if cam["t"] not in cache:
        try:
            with urllib.request.urlopen(cam["image"], timeout=20) as r:
                jpg = r.read()
        except (OSError, urllib.error.URLError) as e:
            log(f"cam frame {cam['image']}: {e}")
            return
        cache.clear()
        cache[cam["t"]] = (mx.upload(jpg, "wailea-cam.jpg", "image/jpeg"), len(jpg))
    mxc, size = cache[cam["t"]]
    mx.image(room, mxc, "wailea-cam.jpg", size, 1920, 1080, reply_to=reply_to, mimetype="image/jpeg")


def escape(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def rating_line():
    """Node-RED's best bet and both sides' scores, or None if there's no
    rating newer than run_alerts.STALE."""
    r = WEATHER.rating if WEATHER else None
    if not r or time.time() - r["t"] > run_alerts.STALE:
        return None
    # The better side first, with its score: "North shore 4/10 · Kīhei 3/10".
    sides = sorted(run_alerts.SIDES.items(), key=lambda kv: -r[kv[0]])
    scores = " · ".join(f"{name} {run_alerts.out_of_10(r[side])}" for side, name in sides)
    rec = r["rec"].lower()
    lead = "go paddleboarding · " if rec.startswith("no can") else "either, " if rec.startswith("either") else ""
    return f"Best bet: {lead}{scores} ({when(r['t'])})"


def conditions(mx, room, event_id, images, frames, charts=False):
    """Reply with the run rating, wind and buoys, the cam frame and, with
    charts, each buoy's spectrum image. images caches (site, epoch) ->
    uploaded mxc, so asking again before the next reading doesn't upload
    the same picture again."""
    lines, cam = [], fresh_cam()
    best = rating_line()
    if best:
        lines.append(("🏄 ", best))
    for w in wind_now():
        lines.append(("🌬️ ", wind_line(*w)))
        if w[0] == "wailea" and cam:  # the cam goes under Wailea's wind
            lines.append(("📷 ", cam_line(cam)))
        if w[0] == "wailea" and motion_line():
            lines.append(("〰️ ", motion_line()))
    if cam and not any(a == "📷 " for a, _ in lines):
        lines.append(("📷 ", cam_line(cam)))
    tide = tide_line()
    if tide:
        lines.append(("↕️ ", tide))
    buoys = swells_now()
    lines += [("🌊 ", f"{site_name(s)} {when(t)}: {swell_kj_text(sw)}") for s, t, sw in buoys]
    if not lines:
        mx.notice(room, "No wind or buoy readings in the last day.", reply_to=event_id)
        return
    mx.notice(room, "\n".join(a + b for a, b in lines), reply_to=event_id,
              html="<br>".join(a + (f'<a href="{CAM_PAGE}">{escape(b)}</a>' if a == "📷 " else escape(b))
                               for a, b in lines))
    if cam:
        send_cam_frame(mx, room, cam, frames, reply_to=event_id)
    for site, t, sw in buoys if charts else ():
        key = (site, t)
        if key not in images:
            try:
                png = spectrum_png(site, t, sw)
            except (OSError, subprocess.CalledProcessError) as e:
                log(f"spectrum image failed: {e}")
                continue
            if not png:
                continue
            images[key] = (mx.upload(png, f"{site}-spectrum.png", "image/png"), len(png))
        mxc, size = images[key]
        mx.image(room, mxc, f"{site}-spectrum.png", size, 1800, 760, reply_to=event_id)


