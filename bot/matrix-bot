def unalias(text):
    """text with its command spelled out if it starts with an unambiguous
    prefix of one ("!c chart" → "!conditions chart")."""
    word, sp, rest = text.partition(" ")
    if not word.startswith("!") or word[1:] in COMMANDS:
        return text
    hits = [c for c in COMMANDS if word[1:] and c.startswith(word[1:])]
    return f"!{hits[0]}{sp}{rest}" if len(hits) == 1 else text


def help_text(sections):
    """(text, html) for [(heading, [(command, what)])]."""
    text, html = [], []
    for head, cmds in sections:
        text += [head, *(f"  {c}: {w}" for c, w in cmds)]
        html.append(f"<b>{escape(head)}</b><ul>"
                    + "".join(f"<li><code>{escape(c)}</code> {escape(w)}</li>" for c, w in cmds)
                    + "</ul>")
    text.append("Any unambiguous start of a command works, like !c for !conditions.")
    html.append("<p>Any unambiguous start of a command works, like <code>!c</code> for <code>!conditions</code>.</p>")
    return "\n".join(text), "".join(html)


