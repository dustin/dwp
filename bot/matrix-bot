def log(msg):
    print(f"{time.strftime('%F %T')} {msg}", file=sys.stderr, flush=True)


class Matrix:
    def __init__(self, homeserver, token):
        self.base = homeserver.rstrip("/")
        self.token = token
        self.txn = int(time.time() * 1000)

    def call(self, method, path, body=None, params=None, raw=False, timeout=60):
        url = self.base + path
        if params:
            url += "?" + urllib.parse.urlencode(params)
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(url, data=data, method=method,
                                     headers={"Authorization": f"Bearer {self.token}",
                                              "Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.read() if raw else json.load(r)

    def send(self, room, content, kind="m.room.message"):
        self.txn += 1
        path = (f"/_matrix/client/v3/rooms/{urllib.parse.quote(room)}"
                f"/send/{kind}/{self.txn}")
        try:
            return self.call("PUT", path, content).get("event_id")
        except (urllib.error.URLError, OSError) as e:
            log(f"send failed: {e}")
            return None

    def notice(self, room, text, reply_to=None, html=None):
        content = {"msgtype": "m.notice", "body": text}
        if html:
            content.update(format="org.matrix.custom.html", formatted_body=html)
        if reply_to:
            content["m.relates_to"] = {"m.in_reply_to": {"event_id": reply_to}}
        return self.send(room, content)

    def react(self, room, event_id, key):
        self.send(room, {"m.relates_to": {"rel_type": "m.annotation",
                                          "event_id": event_id, "key": key}},
                  kind="m.reaction")

    def upload(self, data, filename, mimetype):
        """mxc:// URL of data, uploaded to the homeserver's media store."""
        req = urllib.request.Request(
            self.base + "/_matrix/media/v3/upload?" + urllib.parse.urlencode({"filename": filename}),
            data=data, method="POST",
            headers={"Authorization": f"Bearer {self.token}", "Content-Type": mimetype})
        with urllib.request.urlopen(req, timeout=60) as r:
            return json.load(r)["content_uri"]

    def image(self, room, mxc, filename, size, w, h, reply_to=None, mimetype="image/png"):
        content = {"msgtype": "m.image", "body": filename, "url": mxc,
                   "info": {"mimetype": mimetype, "size": size, "w": w, "h": h}}
        if reply_to:
            content["m.relates_to"] = {"m.in_reply_to": {"event_id": reply_to}}
        self.send(room, content)

    def edit(self, room, event_id, text):
        """Replace a notice's text in place (no notification)."""
        self.send(room, {"msgtype": "m.notice", "body": "* " + text,
                         "m.new_content": {"msgtype": "m.notice", "body": text},
                         "m.relates_to": {"rel_type": "m.replace", "event_id": event_id}})

    def pinned(self, room):
        try:
            return self.call("GET", f"/_matrix/client/v3/rooms/{urllib.parse.quote(room)}"
                                    "/state/m.room.pinned_events").get("pinned", [])
        except urllib.error.HTTPError as e:
            if e.code == 404:
                return []
            raise

    def pin(self, room, event_id):
        """Pin event_id first; needs the power to send m.room.pinned_events."""
        self.call("PUT", f"/_matrix/client/v3/rooms/{urllib.parse.quote(room)}"
                         "/state/m.room.pinned_events",
                  {"pinned": [event_id] + [e for e in self.pinned(room) if e != event_id]})

    def download(self, mxc):
        server, media = mxc[len("mxc://"):].split("/", 1)
        tail = f"/download/{urllib.parse.quote(server)}/{urllib.parse.quote(media)}"
        try:  # authenticated media (Matrix 1.11), then the old unauthenticated path
            return self.call("GET", "/_matrix/client/v1/media" + tail, raw=True)
        except urllib.error.HTTPError as e:
            if e.code not in (400, 404, 405):
                raise
            return self.call("GET", "/_matrix/media/v3" + tail, raw=True)


def client_url(homeserver):
    """The client API base for a server name (e.g. sallings.org), from its
    .well-known; a full https:// URL is taken as is."""
    if "://" in homeserver:
        return homeserver
    try:
        with urllib.request.urlopen(f"https://{homeserver}/.well-known/matrix/client",
                                    timeout=30) as r:
            return json.load(r)["m.homeserver"]["base_url"]
    except (urllib.error.URLError, OSError, KeyError, ValueError) as e:
        log(f"no .well-known for {homeserver} ({e}), trying it directly")
        return f"https://{homeserver}"


