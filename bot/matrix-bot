def run(cmd, env=None, cwd=DB_DIR):
    """Run cmd (in db/ by default); (ok, combined output)."""
    log("+ " + " ".join(cmd))
    r = subprocess.run(cmd, cwd=cwd, env=env, stdout=subprocess.PIPE,
                       stderr=subprocess.STDOUT, text=True)
    sys.stderr.write(r.stdout)
    return r.returncode == 0, r.stdout


def query(sql):
    """Rows of a query against the lake, as dicts."""
    r = subprocess.run(["duckdb", "--init", "init.sql", "-json", "-c", "use lake; " + sql],
                       cwd=LAKE_DIR, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                       text=True)
    out = r.stdout[r.stdout.find("["):] if "[" in r.stdout else "[]"
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return []


def runs(rider):
    """The rider's run ids."""
    return {row["id"] for row in query(
        f"select id::varchar as id from dwlist where rider = '{rider}'")}


# --- run summaries ----------------------------------------------------------

DRY_LIMIT = 0.97  # dryLimit in web/lib/components/data.js
HST = ZoneInfo("Pacific/Honolulu")


def latest(rider, dwid=None):
    """A run's summary fields: dwid's, else the rider's latest."""
    which = f"id = '{dwid}'" if dwid else f"rider = '{rider}' order by ts desc limit 1"
    rows = query(
        "select id::varchar as id, ts, start_beach, end_beach, foil, distance_km, "
        "distance_on_foil, duration_on_foil, avg_foiling_hr, min_foiling_hr, max_speed_1k, "
        f"longest_segment_distance from dwlist_resolved where {which}")
    return rows[0] if rows else None


def dur(sec):
    h, m = divmod(round(sec / 60), 60)
    return f"{h}h {m:02d}m" if h else f"{m}m"


def pace(kmh):
    m, s = divmod(round(3600 / kmh), 60)
    return f"{m}:{s:02d}/km"


def summary(r, rider):
    """(text, html) describing run r."""
    when = datetime.fromtimestamp(r["ts"], HST)
    head = (f"{r['start_beach']} → {r['end_beach']} · "
            f"{when:%a %b} {when.day} {when:%H:%M}")
    lines = []
    foil_m, foil_s = r.get("distance_on_foil"), r.get("duration_on_foil")
    if foil_m and foil_s:
        lines.append(f"🏄 {foil_m / 1000:.1f} km on foil in {dur(foil_s)}")
        lines.append(f"⚡ {foil_m / foil_s * 3.6:.1f} km/h foiling"
                     + (f" · best km {pace(r['max_speed_1k'])}" if r.get("max_speed_1k") else ""))
    elif r.get("distance_km"):
        lines.append(f"📏 {r['distance_km']:.1f} km")
    if r.get("avg_foiling_hr"):
        lines.append(f"❤️ {r['avg_foiling_hr']:.0f} avg · {r['min_foiling_hr']:.0f} min bpm")
    if foil_m and r.get("longest_segment_distance") is not None:
        frac = r["longest_segment_distance"] / foil_m
        lines.append("★ dry!" if frac > DRY_LIMIT
                     else f"💦 not dry: longest flight {frac:.0%} of foiling")
    if r.get("foil"):
        lines.append(f"🪽 {r['foil']}")
    url = f"https://{rider}.downwind.pro/run.html?id={r['id']}"
    text = "\n".join([head, *lines, url])
    html = "<br>".join([f'<a href="{url}"><b>{escape(head)}</b></a>',
                        *map(escape, lines)])
    return text, html


def achievements(rider, dwid):
    """Lines for the records run dwid set, from achievements.mjs (the web's
    own achievements code) over a fresh export of the rider's runs.csv."""
    try:
        with tempfile.TemporaryDirectory(prefix="dwp-ach-") as tmp:
            dwp_publish.export_lists(rider, tmp)
            r = subprocess.run(["node", os.path.join(BOT_DIR, "achievements.mjs"),
                                os.path.join(tmp, "runs.csv"), "--run", dwid],
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                               timeout=120)
        if r.returncode != 0:
            log(f"achievements.mjs failed:\n{r.stderr}")
            return []
        found = json.loads(r.stdout)
    except (dwp_publish.PublishError, OSError, subprocess.SubprocessError, ValueError) as e:
        log(f"achievements failed: {e}")
        return []
    lines = []
    for a in found[0]["records"] if found else []:
        if a["event"]:
            lines.append(f"🎉 {a['note'] or a['label']}")
            continue
        what = a["label"] + (f" ({a['group']})" if a["group"] else "")
        prev = a["prev"]
        on = prev and datetime.fromisoformat(prev["ts"].replace("Z", "+00:00")).astimezone(HST)
        if a["matched"]:
            lines.append(f"🤝 matched {what}: {a['display']} (from {on:%Y-%m-%d})")
        elif prev:
            lines.append(f"🏆 {what}: {a['display']} (was {prev['display']}, {on:%Y-%m-%d})")
        else:
            lines.append(f"🏆 {what}: {a['display']} (first)")
    return lines


def tail(out, n=15):
    return "\n".join(out.rstrip().splitlines()[-n:])


def import_gpx(mx, room, event_id, path, foil, rider):
    mx.react(room, event_id, "👀")
    before = runs(rider)
    cmd = ["./add-run", path, "--rider", rider]
    new_foil = re.match(r"new\s+(.+)", foil, re.I)
    if new_foil:
        cmd[2:2] = [new_foil.group(1), "--new-foil"]
    elif foil and foil != "-":
        cmd.insert(2, foil)
    ok, out = run(cmd)
    if not ok:
        why = next((ln for ln in reversed(out.splitlines())
                    if "foil matches" in ln or "foil from" in ln), None)
        if why:  # the foil lookup failed: ask again, the file waits
            why = why.split("Error: ")[-1].strip()
            mx.notice(room, f"🤔 {why}\nWhich foil? If it's one you haven't ridden "
                            "before, send its full name after \"new\", e.g. "
                            "new Axis Spitfire 1180.", reply_to=event_id)
        else:
            mx.notice(room, f"❌ add-run failed:\n{tail(out)}", reply_to=event_id,
                      html=f"❌ add-run failed:<pre><code>{escape(tail(out))}</code></pre>")
        return False
    new = runs(rider) - before
    r = latest(rider, new.pop()) if len(new) == 1 else None
    if not r:
        mx.notice(room, "✅ imported (couldn't tell which run it is)", reply_to=event_id)
        return True
    text, html = summary(r, rider)
    new = achievements(rider, r["id"])
    if new:
        text += "\n" + "\n".join(new)
        html += "<br>" + "<br>".join(map(escape, new))
    mx.notice(room, "✅ " + text, reply_to=event_id, html="✅ " + html)
    return True


def sql_str(v):
    return "'" + v.replace("'", "''") + "'"


def resolve_foil(rider, name):
    """(foil, None) for the one known foil name names, else (None, why).

    Matches like import.sql: a case-insensitive piece of the name, an exact
    name always winning; the rider's own foils first, then everyone's (a
    rider whose runs say "unknown" may share a foil with someone else)."""
    new = re.match(r"new\s+(.+)", name, re.I)
    if new:
        return new.group(1).strip(), None
    for where in (f"rider = '{rider}' and ", ""):
        known = [row["foil"] for row in query(
            f"select distinct foil from dwlist where {where}foil is not null")]
        exact = [f for f in known if f.lower() == name.lower()]
        hits = exact or [f for f in known if name.lower() in f.lower()]
        if len(hits) == 1:
            return hits[0], None
        if len(hits) > 1:
            return None, f"'{name}' matches more than one foil: {', '.join(sorted(hits))}"
    return None, f"no foil matches '{name}'"


def set_foil(mx, room, event_id, rider, name):
    """Record foil name on the rider's latest run, then re-export."""
    r = latest(rider)
    if not r:
        mx.notice(room, f"No runs for {rider}.", reply_to=event_id)
        return
    foil, why = resolve_foil(rider, name)
    if why:
        mx.notice(room, f"🤔 {why}. If it's a foil nobody has ridden yet, send its "
                        "full name after \"new\", e.g. !foil new Axis Spitfire 1180.",
                  reply_to=event_id)
        return
    mx.react(room, event_id, "👀")
    sql = ("use lake; begin; "
           f"call lake.set_commit_message('dustin', 'matrix-bot: foil of {r['id']}'); "
           f"update dwlist set foil = {sql_str(foil)} where id = '{r['id']}'; commit;")
    ok, out = run(["duckdb", "--init", "init.sql", "-c", sql], cwd=LAKE_DIR)
    if ok:
        try:
            dwp_publish.run()
        except dwp_publish.PublishError as e:
            ok, out = False, str(e)
    if not ok:
        mx.notice(room, f"❌ couldn't change the foil:\n{tail(out)}", reply_to=event_id,
                  html=f"❌ couldn't change the foil:<pre><code>{escape(tail(out))}</code></pre>")
        return
    text, html = summary(latest(rider, r["id"]), rider)
    was = r.get("foil") or "none"
    mx.notice(room, f"✅ foil was {was}\n{text}", reply_to=event_id,
              html=f"✅ foil was {escape(was)}<br>{html}")


