def condense(out, keep=5):
    """out with each run of more than keep similar lines (orphan: ...,
    would upload ..., an invalidation path) cut to its first keep."""
    lines, kind, n = [], None, 0
    for ln in out.rstrip().splitlines():
        m = LISTED.match(ln)
        k = m.group(0) if m else None
        if k != kind:
            if n > keep:
                lines.append(f"… and {n - keep} more")
            kind, n = k, 0
        n += 1
        if k is None or n <= keep:
            lines.append(ln)
    if n > keep:
        lines.append(f"… and {n - keep} more")
    return "\n".join(lines)


def publish(mx, room, event_id, words):
    """./publish with words, replying with its (condensed) output."""
    mx.react(room, event_id, "👀")
    ok, out = run(["./publish", *words])
    what = " ".join(["publish", *words])
    body = tail(condense(out), 25) or "(no output)"
    mark = "✅" if ok else "⚠️"
    mx.notice(room, f"{mark} {what}\n{body}", reply_to=event_id,
              html=f"{mark} {escape(what)}<pre><code>{escape(body)}</code></pre>")


def drive_riders():
    """Riders with an rclone remote of their own name (see db/drive-sync)."""
    ok, out = run(["rclone", "listremotes"])
    remotes = {ln.strip().rstrip(":") for ln in out.splitlines()} if ok else set()
    return remotes & {r["rider"] for r in query("select distinct rider from dwlist")}


def sync(mx, room, event_id, riders):
    """drive-sync for riders (everyone with a Drive folder if empty)."""
    mx.react(room, event_id, "👀")
    drive = drive_riders()
    missing = [r for r in riders if r not in drive]
    if missing:
        mx.notice(room, f"No Drive folder (rclone remote) for {', '.join(missing)}.",
                  reply_to=event_id)
    want = [r for r in riders if r in drive] if riders else sorted(drive)
    if not want and not missing:
        mx.notice(room, "Nobody has a Drive folder to sync.", reply_to=event_id)
    jobs = [(f"Drive ({r})", ["./drive-sync", r]) for r in want]
    before = {r: runs(r) for r in want}
    for what, cmd in jobs:
        with SYNC_LOCK:
            ok, out = run(cmd)
        summary = next((ln for ln in reversed(out.splitlines()) if ln.startswith("imported ")),
                       "")
        if ok:
            mx.notice(room, f"✅ {what}: {summary or 'synced'}", reply_to=event_id)
        else:
            mx.notice(room, f"❌ {what} sync failed:\n{tail(out)}", reply_to=event_id,
                      html=f"❌ {escape(what)} sync failed:"
                           f"<pre><code>{escape(tail(out))}</code></pre>")
        for r in want:  # describe what came in, like a GPX import
            new = runs(r) - before[r]
            before[r] |= new
            announce(mx, room, event_id, r, new)


SYNC_SUMMARIES = 5  # a first sync can bring in dozens; describe only the latest


SYNC_LOCK = threading.Lock()  # one drive-sync at a time, asked for or scheduled


def announce(mx, room, event_id, rider, dwids):
    """A summary plus records for each newly imported run, oldest first."""
    for text, html in new_runs(rider, dwids):
        mx.notice(room, text, reply_to=event_id, html=html)


def new_runs(rider, dwids):
    """(text, html) messages describing newly imported runs (see announce)."""
    rows = sorted(filter(None, (latest(rider, d) for d in dwids)), key=lambda r: r["ts"])
    msgs = []
    if len(rows) > SYNC_SUMMARIES:
        msgs.append((f"{rider}: {len(rows)} runs imported, describing the latest "
                     f"{SYNC_SUMMARIES}", None))
    for r in rows[-SYNC_SUMMARIES:]:
        text, html = summary(r, rider)
        text, html = f"{rider.title()}: {text}", f"{escape(rider.title())}: {html}"
        recs = achievements(rider, r["id"])
        if recs:
            text += "\n" + "\n".join(recs)
            html += "<br>" + "<br>".join(map(escape, recs))
        msgs.append((text, html))
    return msgs


def last_sync_slot(now):
    """The epoch of the latest SYNC_HOURS slot at or before now."""
    h = hst(now)
    for days in (0, 1):
        day = h - timedelta(days=days)
        slots = [day.replace(hour=hr, minute=0, second=0, microsecond=0) for hr in SYNC_HOURS]
        past = [s for s in slots if s <= h]
        if past:
            return max(past).timestamp()


