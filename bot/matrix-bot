def is_gpx(c):
    name = (c.get("filename") or c.get("body") or "").lower()
    return c.get("msgtype") == "m.file" and "url" in c and (
        name.endswith(".gpx") or "gpx" in c.get("info", {}).get("mimetype", ""))


def caption(c):
    """A file's caption (Matrix 1.10: a body that differs from filename)."""
    fn, body = c.get("filename"), c.get("body", "")
    return body.strip() if fn and body != fn else ""


FOIL = re.compile(r"^(-|[\w .'-]{1,60})$")


class Bot:
    def __init__(self, mx, args):
        self.mx, self.args = mx, args
        self.started = time.time()
        self.pending = {}  # (room, sender) -> (event_id, gpx path, received at)
        self.tmp = tempfile.mkdtemp(prefix="dwp-matrix-")
        self.images = {}  # (buoy, reading epoch) -> (mxc, size): see conditions
        self.frames = {}  # cam reading time -> (mxc, size): see send_cam_frame
        self.status, self.status_at, self.edited = None, 0, 0
        self.asks = {}  # preview event id -> a change waiting for ✅: see ask_runs
        # question event id -> invited room (see invited), kept across
        # restarts: a sync only mentions an invite once.
        self.invites_file = os.path.join(args.state_dir, "invites.json")
        self.invites = json.loads(load_state(self.invites_file) or "{}")
        self.rooms_file = os.path.join(args.state_dir, "rooms")
        self.rooms = list(dict.fromkeys(args.room + (load_state(self.rooms_file) or "").split()))
        self.settings_file = os.path.join(args.state_dir, "room-settings.json")
        self.settings = json.loads(load_state(self.settings_file) or "{}")

    def on(self, room, key):
        """Whether room gets key (see ROOM_SETTINGS); everything's on by default."""
        return self.settings.get(room, {}).get(key, True)

    def room_name(self, room):
        """"name (#alias)", or whichever of them it has, or the room id."""
        def get(kind, key):
            try:
                return self.mx.call("GET", f"/_matrix/client/v3/rooms/{urllib.parse.quote(room)}"
                                           f"/state/{kind}").get(key)
            except (urllib.error.URLError, OSError):
                return None
        name, alias = get("m.room.name", "name"), get("m.room.canonical_alias", "alias")
        return f"{name} ({alias})" if name and alias else name or alias or room

    def list_rooms(self, room, eid):
        lines = []
        for i, r in enumerate(self.rooms, 1):
            what = ", ".join(f"{v} {'on' if self.on(r, k) else 'off'}"
                             for k, v in ROOM_SETTINGS.items())
            lines.append(f"{i}. {self.room_name(r)}{' (this room)' if r == room else ''}: {what}")
        self.mx.notice(room, "\n".join(lines + ["Change one with !room N alerts off "
                                                "(or cam, pinned; on; leave)."]), reply_to=eid)

    def room_command(self, room, eid, words):
        """!room N (alerts|cam|pinned|sources) (on|off), or !room N leave."""
        usage = "!room takes a number from !rooms and a setting, like !room 2 alerts off or !room 2 leave"
        if not words or not words[0].isdigit() or not 1 <= int(words[0]) <= len(self.rooms):
            self.mx.notice(room, usage, reply_to=eid)
            return
        target = self.rooms[int(words[0]) - 1]
        if words[1:] == ["leave"]:
            if target in self.args.room:
                self.mx.notice(room, "That room is in my config; it stays.", reply_to=eid)
                return
            self.mx.call("POST", f"/_matrix/client/v3/rooms/{urllib.parse.quote(target)}/leave", {})
            name = self.room_name(target)
            self.left(target)
            self.mx.notice(room, f"✅ left {name}", reply_to=eid)
            return
        if len(words) != 3 or words[1] not in ROOM_SETTINGS or words[2] not in ("on", "off"):
            self.mx.notice(room, usage, reply_to=eid)
            return
        key, want = words[1], words[2] == "on"
        self.settings.setdefault(target, {})[key] = want
        save_state(self.settings_file, json.dumps(self.settings))
        if key == "pinned" and not want:  # take its conditions message down
            path = self.state_path("pinned", target)
            pinned = load_state(path)
            if pinned and pinned in self.mx.pinned(target):
                try:
                    self.mx.call("PUT", f"/_matrix/client/v3/rooms/{urllib.parse.quote(target)}"
                                        "/state/m.room.pinned_events",
                                 {"pinned": [e for e in self.mx.pinned(target) if e != pinned]})
                except urllib.error.URLError as e:
                    log(f"unpinning in {target} failed: {e}")
            if pinned:
                os.unlink(path)
        self.mx.notice(room, f"✅ {ROOM_SETTINGS[key]} {words[2]} in {self.room_name(target)}",
                       reply_to=eid)

    def save_rooms(self):
        """Keep the rooms joined by invite (the --room ones are always in)."""
        save_state(self.rooms_file, "\n".join(r for r in self.rooms if r not in self.args.room))

    def invited(self, room, invite):
        """Ask the first room whether to join room, once per invite."""
        if room in self.invites.values():
            return
        state = {(e.get("type"), e.get("state_key")): e
                 for e in invite.get("invite_state", {}).get("events", [])}
        name = state.get(("m.room.name", ""), {}).get("content", {}).get("name")
        alias = state.get(("m.room.canonical_alias", ""), {}).get("content", {}).get("alias")
        where = f"{name} ({alias or room})" if name else alias or room
        by = next((e.get("sender") for (t, _), e in state.items()
                   if t == "m.room.member" and e.get("content", {}).get("membership") == "invite"),
                  "someone")
        text = (f"📨 {by} invited me to {where}. A room admin's ✅ here "
                "and I'll join; I'll answer commands there and post run alerts and "
                "conditions there too (!rooms to change what it gets).")
        qid = self.mx.notice(self.rooms[0], text)
        if qid:
            self.invites[qid] = room
            self.save_invites()
        log(f"invited to {room} by {by}")

    def accept(self, room, ev):
        """Join the room a room admin's ✅ on an invite question names."""
        rel = ev.get("content", {}).get("m.relates_to", {})
        target = self.invites.get(rel.get("event_id"))
        if not target or room != self.rooms[0]:
            return False
        key = (rel.get("key") or "").replace("\ufe0f", "")
        log(f"{ev['sender']} reacted {key!r} to the invite to {target}")
        if key not in APPROVE:
            return True
        if not self.room_admin(room, ev["sender"]):
            self.mx.notice(room, "Only a room admin's ✅ lets me join.", reply_to=rel["event_id"])
            return True
        try:
            self.mx.call("POST", f"/_matrix/client/v3/join/{urllib.parse.quote(target)}", {})
        except urllib.error.URLError as e:  # the question stays for another ✅
            log(f"joining {target} failed: {e}")
            self.mx.notice(room, f"❌ couldn't join {target}: {e}", reply_to=rel["event_id"])
            return True
        self.joined(target)
        self.mx.notice(room, f"✅ joined {self.room_name(target)}", reply_to=rel["event_id"])
        return True

    def save_invites(self):
        save_state(self.invites_file, json.dumps(self.invites))

    def forget_invite(self, room):
        if room in self.invites.values():
            self.invites = {q: r for q, r in self.invites.items() if r != room}
            self.save_invites()

    def joined(self, room):
        if room not in self.rooms:
            self.rooms.append(room)
            self.save_rooms()
        self.forget_invite(room)

    def left(self, room):
        """Forget a room the bot was kicked from or left (not --room ones),
        or an invite that was taken back."""
        self.forget_invite(room)
        if room in self.rooms and room not in self.args.room:
            self.rooms.remove(room)
            self.save_rooms()
            log(f"left {room}")

    def refresh_status(self):
        """Every STATUS_EVERY seconds, edit the latest conditions into the
        bot's pinned message (Element X shows it in a banner atop the room),
        if they've changed (not just their time) and it's been EDIT_EVERY
        since the last edit, posting it the first time and pinning it again
        if someone unpinned it. Each edit is an event in the room, so
        fewer of them is less churn for everyone's clients."""
        if time.time() - self.status_at < STATUS_EVERY:
            return
        self.status_at = time.time()
        line = status_line()
        if not line:
            return
        now = time.time()
        edit = (line.split(" · as of ")[0] != (self.status or "").split(" · as of ")[0]
                and now - self.edited >= EDIT_EVERY)
        for room in self.rooms:
            if not self.on(room, "pinned"):
                continue
            try:
                self.pin_status(room, line, edit)
            except Exception as e:  # one room's trouble shouldn't stop the others
                log(f"pinned conditions in {room} failed: {e!r}")
        if edit:
            self.status, self.edited = line, now

    def pin_status(self, room, line, edit):
        """Post, edit (if edit) and pin room's conditions message."""
        path = self.state_path("pinned", room)
        pinned = load_state(path)
        if not pinned:
            pinned = self.mx.notice(room, line)
            if not pinned:
                return
            save_state(path, pinned)
        elif edit:
            self.mx.edit(room, pinned, line)
        # The message is saved before it's pinned, so a bot without the
        # power to pin (403) keeps editing its one message rather than
        # posting a new one every few minutes.
        if pinned not in self.mx.pinned(room):
            self.mx.pin(room, pinned)

    def state_path(self, name, room):
        """state-dir/name for the first room (where it always was), else
        state-dir/name-<room id>."""
        if room != self.rooms[0]:
            name += "-" + urllib.parse.quote(room, safe="")
        return os.path.join(self.args.state_dir, name)

    def broadcast(self, content, key):
        """Send content to every room that has key (see ROOM_SETTINGS) on."""
        for room in self.rooms:
            if self.on(room, key):
                self.mx.send(room, content)

    def announce_ratings(self):
        """Tell the room when a run's getting good (see run_alerts.py), as
        plain text rather than a notice, so it notifies like a person would."""
        if not WEATHER:
            return
        if not hasattr(self, "alerts"):
            self.alerts = run_alerts.Alerts(os.path.join(self.args.state_dir, "rating.json"))
        while not WEATHER.ratings.empty():
            rating = WEATHER.ratings.get()
            said = self.alerts.see(rating)
            if not said:
                continue
            wind = {site: wind_line(site, r, before) for site, r, before in wind_now()}
            cam = fresh_cam()
            lines = {"kihei": [wind[s] for s in ("kihei", "wailea") if s in wind]
                     + ([cam_line(cam)] if cam else [])
                     + [m for m in (motion_line(),) if m],
                     "ns": [wind[s] for s in ("hookipa",) if s in wind]}
            for kind, sides in said:
                self.broadcast({"msgtype": "m.text", "body": run_alerts.message(
                    kind, sides, rating, lines)}, "alerts")

    def watch_sources(self):
        """Tell every room once when a data source stops reporting in its
        hours, and once when it's back (see sources.py)."""
        now = time.time()
        if now - self.started < WATCH_GRACE or now - getattr(self, "watched", 0) < WATCH_EVERY:
            return
        self.watched = now
        if not hasattr(self, "watch"):
            self.watch = sources.Watch(os.path.join(self.args.state_dir, "sources-down.json"))
        newest = {}
        rows = query("select max(epoch(ts)) as t from swell_partition "
                     "where site = 'pauwela' and ts > now() - interval 7 day")
        if rows:  # none at all means the lake couldn't be read: no telling
            newest["pauwela"] = rows[0]["t"]
        if WEATHER:
            live = WEATHER.recent()
            for site in ("kihei", "hookipa", "wailea"):
                newest[site] = live[site][-1]["t"] if live.get(site) else None
            for cam in ("wailea", "ulua", "poolenalena"):
                m = WEATHER.water_motion(cam)
                newest["cam:" + cam] = m and m["t"]
            newest["rating"] = WEATHER.rating and WEATHER.rating["t"]
        h = hst(now)
        for kind, key, t in self.watch.see(newest, h.hour + h.minute / 60, now):
            self.broadcast({"msgtype": "m.text",
                            "body": sources.message(kind, key, t, when)}, "sources")

    def scheduled_sync(self):
        """At each of SYNC_HOURS (Hawaii), sync every rider's Drive in the
        background and tell rooms with "runs" on about any new runs; quiet
        when there are none. The last slot done is kept in state-dir, so a
        restart neither repeats one nor misses one it was down for."""
        if getattr(self, "syncing", None) and self.syncing.is_alive():
            return
        path = os.path.join(self.args.state_dir, "scheduled-sync")
        now = time.time()
        done = load_state(path)
        if not done:  # first start: from now on, not catching up on yesterday
            save_state(path, str(now))
            return
        slot = last_sync_slot(now)
        if float(done) >= slot:
            return
        save_state(path, str(now))
        self.syncing = threading.Thread(target=self.sync_all, name="scheduled-sync", daemon=True)
        self.syncing.start()

    def sync_all(self):
        try:
            for rider in sorted(drive_riders()):
                before = runs(rider)
                with SYNC_LOCK:
                    ok, out = run(["./drive-sync", rider])
                if not ok:
                    log(f"scheduled sync for {rider} failed:\n{tail(out)}")
                    self.mx.notice(self.rooms[0], f"❌ Scheduled Drive ({rider}) sync failed:\n"
                                                  f"{tail(out)}")
                    continue
                for text, html in new_runs(rider, runs(rider) - before):
                    content = {"msgtype": "m.notice", "body": text}
                    if html:
                        content.update(format="org.matrix.custom.html", formatted_body=html)
                    self.broadcast(content, "runs")
        except Exception as e:
            log(f"scheduled sync failed: {e!r}")

    def suggest_cam(self):
        """Once a Hawaii day, when Kīhei's rating reaches LOOK and the Wailea
        cam reads LIVELY (both fresh), suggest a look at the cam."""
        cam, rating = fresh_cam(), WEATHER.rating if WEATHER else None
        if not cam or cam["sea"] not in LIVELY or not rating:
            return
        if time.time() - rating["t"] > run_alerts.STALE or rating["kihei"] < LOOK:
            return
        path, today = os.path.join(self.args.state_dir, "cam-nudge"), f"{hst(time.time()):%F}"
        if load_state(path) == today:
            return
        save_state(path, today)
        text = (f"👀 The Wailea cam shows {cam['sea']} and Kīhei is at "
                f"{run_alerts.out_of_10(rating['kihei'])}. Worth a look: {CAM_PAGE}")
        self.broadcast({"msgtype": "m.text", "body": text, "format": "org.matrix.custom.html",
                        "formatted_body": escape(text).replace(
                            CAM_PAGE, f'<a href="{CAM_PAGE}">{CAM_PAGE}</a>')}, "cam")
        for room in (r for r in self.rooms if self.on(r, "cam")):
            send_cam_frame(self.mx, room, cam, self.frames)

    def handle(self, room, ev):
        c = ev.get("content", {})
        if ev.get("type") == "m.room.encrypted":
            self.mx.notice(room, "This room is encrypted, and I can only read "
                                 "unencrypted rooms.")
            return
        if ev.get("type") == "m.reaction":
            if not self.accept(room, ev):
                self.approve(room, ev)
            return
        if ev.get("type") != "m.room.message" or "m.relates_to" in c and \
                c["m.relates_to"].get("rel_type") == "m.replace":
            return
        eid, sender = ev["event_id"], ev["sender"]
        rider = self.args.users.get(sender)
        text = unalias(c.get("body", "").strip()) if c.get("msgtype") == "m.text" else ""
        if text.startswith("!conditions"):  # anyone in the room
            conditions(self.mx, room, eid, self.images, self.frames,
                       charts="chart" in text[len("!conditions"):])
            return
        if text.startswith("!help") and not rider:
            body, html = help_text([("Anyone", HELP_ANYONE)])
            self.mx.notice(room, body, reply_to=eid, html=html)
            return
        if room == self.rooms[0] and re.match(r"!rooms?\b", text):
            if not self.room_admin(room, sender):
                self.mx.notice(room, "Only room admins can change rooms.", reply_to=eid)
            elif text.split()[0] == "!rooms":
                self.list_rooms(room, eid)
            else:
                self.room_command(room, eid, text.split()[1:])
            return
        if not rider:
            if text.split()[:1] and text.split()[0] in RIDER_COMMANDS:
                self.mx.react(room, eid, "🚫")  # seen, and not for them
            return
        if is_gpx(c):
            fd, path = tempfile.mkstemp(suffix=".gpx", dir=self.tmp)
            try:
                with os.fdopen(fd, "wb") as fh:
                    fh.write(self.mx.download(c["url"]))
            except (urllib.error.URLError, OSError) as e:
                self.mx.notice(room, f"❌ couldn't download that file: {e}", reply_to=eid)
                return
            foil = caption(c)
            if (room, sender) in self.pending:  # a newer file replaces one still waiting
                os.unlink(self.pending.pop((room, sender))[1])
            if foil and FOIL.match(foil):
                self.attempt(room, sender, eid, path, foil, rider)
            else:
                self.pending[room, sender] = (eid, path, time.time())
                self.mx.notice(room, "Which foil? (e.g. 585, or - for your last "
                                     "one from that beach)", reply_to=eid)
            return
        if c.get("msgtype") != "m.text":
            return
        text = unalias(c.get("body", "").strip())
        if text.startswith("!sync"):
            riders = text.split()[1:]
            if not self.room_admin(room, sender):
                if riders and riders != [rider]:
                    self.mx.notice(room, "You can only sync yourself.", reply_to=eid)
                    return
                riders = [rider]
            if all(RIDER.fullmatch(r) for r in riders):
                sync(self.mx, room, eid, riders)
            else:
                self.mx.notice(room, "!sync takes rider names, like !sync walter",
                               reply_to=eid)
        elif text.startswith("!last"):
            who = text.split()[1:2] or [rider]
            r = latest(who[0]) if RIDER.fullmatch(who[0]) else None
            if r:
                body, html = summary(r, who[0])
                self.mx.notice(room, body, reply_to=eid, html=html)
            else:
                self.mx.notice(room, f"No runs for {who[0]}.", reply_to=eid)
        elif text.startswith("!foil"):
            words = text.split()[1:]
            target = rider
            if len(words) > 1 and words[0] in self.riders():
                if words[0] != rider and not self.room_admin(room, sender):
                    self.mx.notice(room, "You can only change your own runs.",
                                   reply_to=eid)
                    return
                target, words = words[0], words[1:]
            name = " ".join(words)
            if FOIL.match(name):
                set_foil(self.mx, room, eid, target, name)
            else:
                self.mx.notice(room, "!foil takes a foil, like !foil 585 "
                                     "(or !foil walter orca 685)", reply_to=eid)
        elif text.startswith("!ask"):
            words = text.split()[1:]
            # Whose runs: the sender's plus any rider named anywhere ("walter's
            # longest run", "walter and I"). Anyone may ask about anyone
            # (their runs are on their site anyway); changes still need an
            # admin's ✅.
            named = {w for w in re.findall(r"[a-z][a-z0-9-]*", " ".join(words).lower()
                                           .replace("'s", "").replace("’s", ""))
                     if w in self.riders()}
            riders = [rider] + sorted(named - {rider})
            if words:
                # The model takes a while; keep the room's other commands going.
                threading.Thread(target=self.ask_runs, args=(room, eid, rider, riders, " ".join(words)),
                                 name="ask", daemon=True).start()
            else:
                self.mx.notice(room, "!ask takes a question or a change, like "
                                     "!ask when did I last go to Ulua?", reply_to=eid)
        elif text.startswith("!publish"):
            words = text.split()[1:]
            if not self.room_admin(room, sender):
                self.mx.notice(room, "Only room admins can publish.", reply_to=eid)
            elif not set(words) <= PUBLISH_WORDS or words[1:] and \
                    set(words[1:]) & {"publish", "verify", "orphans"}:
                self.mx.notice(room, "!publish takes ./publish's words: [verify | orphans] "
                                     "[--dry-run] [--fix] [--delete] [--force]",
                               reply_to=eid)
            else:
                publish(self.mx, room, eid, words)
        elif text.startswith("!help"):
            sections = [("Anyone", HELP_ANYONE), ("Your runs", HELP_RIDER)]
            admin = self.room_admin(room, sender)
            if admin:  # their bare !sync syncs everyone
                sections = [("Anyone", HELP_ANYONE),
                            ("Your runs", [h for h in HELP_RIDER if h[0] != "!sync"]),
                            ("Room admins: any rider", HELP_ADMIN),
                            ("Room admins: publishing", HELP_ROOM_ADMIN)]
                if room == self.rooms[0]:
                    sections.append(("Room admins: rooms", HELP_ROOMS))
            body, html = help_text(sections)
            self.mx.notice(room, body, reply_to=eid, html=html)
        elif (room, sender) in self.pending and FOIL.match(text):
            gpx_eid, path, at = self.pending.pop((room, sender))
            if time.time() - at < PENDING_TTL:
                self.attempt(room, sender, gpx_eid, path, text, rider)
            else:
                os.unlink(path)

    def ask_runs(self, room, eid, me, riders, question):
        """Answer question (from rider me) about riders' runs, or propose the
        change it asks for (applied by approve), via the model and ask.py's
        sandbox."""
        a = self.args
        self.mx.react(room, eid, "👀")
        snap = tempfile.mkdtemp(dir=self.tmp)
        whose = " and ".join(f"{r}'s" for r in riders) + " runs"
        try:
            ask.snapshot(LAKE_DIR, riders, snap)
            context = ask.context(snap, me, riders, [r["name"] for r in query(
                "select name from beaches order by name")])
            p, rows = ask.plan(a.ollama, a.ask_model, question, context, snap)
            if p["kind"] == "unclear":
                self.mx.notice(room, f"🤔 {p.get('say') or 'I did not follow that.'}", reply_to=eid)
                return
            sql = p["sql"]
            if p["kind"] == "edit":
                self.propose(room, eid, question, p, rows, snap)
                return
            said = ask.answer(a.ollama, a.ask_model, question, sql, rows)
            together = bool(re.search(r"\btogether\b", sql, re.I))
            links = [ask.link(snap, r, together) for r in ask.answered_runs(snap, rows, me)]
            tab = ask.table(rows)
            self.mx.notice(room, "\n".join([said, *([tab[0]] if tab else []),
                                            *(f"{l}: {u}" for l, u in links),
                                            f"\nSQL over {whose}: {sql}"]),
                           reply_to=eid,
                           html=escape(said) + (tab[1] if tab else "")
                           + "".join(f'<br>🔗 <a href="{u}">{escape(l)}</a>' for l, u in links)
                           + f"<details><summary>SQL over {escape(whose)}</summary>"
                             f"<pre><code>{escape(sql)}</code></pre></details>")
        except ask.AskError as e:
            self.mx.notice(room, f"🤔 {e}", reply_to=eid)
        except (urllib.error.URLError, OSError) as e:
            self.mx.notice(room, f"❌ couldn't reach the model: {e}", reply_to=eid)
        finally:
            shutil.rmtree(snap, ignore_errors=True)

    def propose(self, room, eid, question, p, rows, snap):
        """Show the change plan p would make, and keep it for a ✅."""
        ids = [r["id"] for r in rows if r.get("id")]
        if len(ids) != len(rows):
            raise ask.AskError("the change's SELECT has to pick runs by id")
        if not ids:
            raise ask.AskError("no runs match that")
        picked = ask.sandboxed(snap, "select * from runs where id in ("
                               + ", ".join(ask.sql_str(i) for i in ids) + ") order by date, time")
        whose = {r["rider"] for r in picked}
        if len(whose) != 1:
            raise ask.AskError(f"one rider's runs at a time, please, not {' and '.join(sorted(whose))}'s")
        rider = whose.pop()
        fields = ask.check_set(p.get("set"), lambda f: resolve_foil(rider, f))
        lines = [ask.run_line(r) + ": " + ", ".join(
            f"{r.get(k) or 'none'} → {v}" for k, v in fields.items()) for r in picked[:20]]
        if len(picked) > 20:
            lines.append(f"… and {len(picked) - 20} more")
        n = len(picked)
        head = f"✏️ Change {n} of {rider}'s runs"
        if p.get("count") and p["count"] != n:
            self.mx.notice(room, f"🤔 You said {p['count']}, but that picks {n}:\n"
                                 + "\n".join(lines) + "\nTry saying which ones another way.",
                           reply_to=eid)
            return
        foot = "A room admin's ✅ on this runs exactly this SQL:"
        sql = ask.apply_sql(rider, ids, fields, question)
        pid = self.mx.notice(room, "\n".join([head + ":", *lines, foot, sql]), reply_to=eid,
                             html=f"<b>{escape(head)}:</b><ul>"
                                  + "".join(f"<li>{escape(l)}</li>" for l in lines)
                                  + f"</ul><details><summary>{escape(foot)}</summary>"
                                    f"<pre><code>{escape(sql)}</code></pre></details>")
        if pid:  # the SQL shown is the SQL run
            self.asks[pid] = {"room": room, "rider": rider, "n": len(ids), "sql": sql, "at": time.time()}

    def approve(self, room, ev):
        """Apply the change a room admin's ✅ reacts to (see propose)."""
        rel = ev.get("content", {}).get("m.relates_to", {})
        change = self.asks.get(rel.get("event_id"))
        if not change or change["room"] != room or rel.get("key") not in APPROVE:
            return
        pid = rel["event_id"]
        if time.time() - change["at"] > ASK_TTL:
            del self.asks[pid]
            self.mx.notice(room, "That change is too old now; ask again.", reply_to=pid)
            return
        if not self.room_admin(room, ev["sender"]):
            return
        del self.asks[pid]
        ok, out = run(["duckdb", "--init", "init.sql", "-c", change["sql"]], cwd=LAKE_DIR)
        if ok:
            try:
                dwp_publish.run()
            except dwp_publish.PublishError as e:
                ok, out = False, str(e)
        if ok:
            self.mx.notice(room, f"✅ changed {change['n']} of {change['rider']}'s runs",
                           reply_to=pid)
        else:
            self.mx.notice(room, f"❌ couldn't apply it:\n{tail(out)}", reply_to=pid,
                           html=f"❌ couldn't apply it:<pre><code>{escape(tail(out))}</code></pre>")

    def room_admin(self, room, sender):
        """Whether sender has admin power (100) in room, read fresh."""
        pl = self.mx.call("GET", f"/_matrix/client/v3/rooms/{urllib.parse.quote(room)}"
                                 "/state/m.room.power_levels")
        return pl.get("users", {}).get(sender, pl.get("users_default", 0)) >= 100

    def riders(self):
        """Every rider: the users' and any others with runs in the lake."""
        return set(self.args.users.values()) | {
            row["rider"] for row in query(
                "select distinct rider from dwlist where rider is not null")}

    def attempt(self, room, sender, eid, path, foil, rider):
        """Import; if that fails, the file waits for another foil."""
        if import_gpx(self.mx, room, eid, path, foil, rider):
            os.unlink(path)
        else:
            self.pending[room, sender] = (eid, path, time.time())


def load_state(path):
    try:
        with open(path) as fh:
            return fh.read().strip() or None
    except FileNotFoundError:
        return None


def save_state(path, since):
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        fh.write(since)
    os.replace(tmp, path)


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--homeserver", required=True,
                    help="server name (e.g. sallings.org) or client API URL")
    ap.add_argument("--room", action="append", required=True,
                    help="room id, e.g. !abc:matrix.org (repeatable; run alerts and "
                         "the pinned conditions go to every room). Invites to other "
                         "rooms are asked about in the first; a room admin's ✅ joins")
    ap.add_argument("--user", action="append", required=True, metavar="MXID=RIDER",
                    help="a Matrix user it listens to, and whose runs their GPX files "
                         "are, e.g. @dustin:sallings.org=dustin (repeatable)")
    ap.add_argument("--admin", action="append", default=[], metavar="MXID",
                    help=argparse.SUPPRESS)  # ignored: room power levels decide now
    ap.add_argument("--token-file", default="~/.config/dwp/matrix-token",
                    help="the bot account's access token")
    ap.add_argument("--state-dir", default="~/.local/state/dwp-matrix-bot")
    ap.add_argument("--ollama", default="http://localhost:11434",
                    help="Ollama's URL, for !ask")
    ap.add_argument("--ask-model", default="qwen3-coder-next:latest",
                    help="the Ollama model !ask uses")
    ap.add_argument("--mqtt", default="mqtt", metavar="HOST[:PORT]",
                    help="broker with the weather/+ station feed (\"\" for none)")
    args = ap.parse_args(argv)
    args.users = {}
    for u in args.user:
        mxid, _, rider = u.partition("=")
        if not mxid.startswith("@") or not RIDER.fullmatch(rider):
            ap.error(f"--user wants @someone:server=rider, not {u}")
        args.users[mxid] = rider

    with open(os.path.expanduser(args.token_file)) as fh:
        mx = Matrix(client_url(args.homeserver), fh.read().strip())
    state_dir = args.state_dir = os.path.expanduser(args.state_dir)
    os.makedirs(state_dir, exist_ok=True)
    state = os.path.join(state_dir, "since")
    bot = Bot(mx, args)
    if args.mqtt:
        global WEATHER
        host, _, port = args.mqtt.partition(":")
        WEATHER = Weather(host, int(port or 1883))
        try:
            seed_weather(WEATHER)
        except Exception as e:  # live wind without history beats none
            log(f"seeding live wind failed: {e!r}")
        WEATHER.start()
        threading.Thread(target=write_live, args=(WEATHER,), name="live", daemon=True).start()

    me = mx.call("GET", "/_matrix/client/v3/account/whoami")["user_id"]
    log(f"{me} listening to {', '.join(args.users)} in {', '.join(args.room)}")
    log(f"also in {', '.join(bot.rooms[len(args.room):]) or 'no rooms by invite'}")
    since = load_state(state)
    first = since is None
    if since:  # invites from before a restart: later syncs won't mention them
        try:
            pending = mx.call("GET", "/_matrix/client/v3/sync", params={"filter": json.dumps(
                {"room": {"timeline": {"limit": 0}, "state": {"types": []},
                          "ephemeral": {"not_types": ["*"]}, "account_data": {"not_types": ["*"]}},
                 "presence": {"not_types": ["*"]}, "account_data": {"not_types": ["*"]}}),
                "timeout": 0}, timeout=90).get("rooms", {}).get("invite", {})
            for room, invite in pending.items():
                if room not in bot.rooms:
                    bot.invited(room, invite)
        except Exception as e:
            log(f"looking for pending invites failed: {e!r}")
    backoff = 5
    while True:
        filt = json.dumps({"room": {"timeline": {"limit": 50},
                                    "state": {"lazy_load_members": True}},
                           "presence": {"not_types": ["*"]},
                           "account_data": {"not_types": ["*"]}})
        params = {"filter": filt, "timeout": 0 if first else 30000}
        if since:
            params["since"] = since
        try:
            resp = mx.call("GET", "/_matrix/client/v3/sync", params=params, timeout=90)
        except (urllib.error.URLError, OSError, json.JSONDecodeError) as e:
            log(f"sync failed: {e}; retrying in {backoff}s")
            time.sleep(backoff)
            backoff = min(backoff * 2, 300)
            continue
        backoff = 5
        rooms = resp.get("rooms", {})
        for room, invite in rooms.get("invite", {}).items():
            if room in bot.rooms:
                log(f"joining {room}")
                try:
                    mx.call("POST", f"/_matrix/client/v3/join/{urllib.parse.quote(room)}", {})
                except urllib.error.URLError as e:
                    log(f"joining {room} failed: {e}")
            else:
                try:
                    bot.invited(room, invite)
                except Exception as e:
                    log(f"asking about {room}'s invite failed: {e!r}")
        for room in rooms.get("leave", {}):
            bot.left(room)
        for room, joined in rooms.get("join", {}).items():
            if first:  # the first sync only finds where "now" is
                break
            if room not in bot.rooms:  # joined some other way; not ours to answer
                continue
            for ev in joined.get("timeline", {}).get("events", []):
                if ev.get("sender") != me:
                    try:
                        bot.handle(room, ev)
                    except Exception as e:  # keep listening whatever one message does
                        log(f"error handling {ev.get('event_id')}: {e!r}")
                        mx.notice(room, f"❌ {e!r}")
        try:
            bot.announce_ratings()
        except Exception as e:
            log(f"run alert failed: {e!r}")
        try:
            bot.watch_sources()
        except Exception as e:
            log(f"source watch failed: {e!r}")
        try:
            bot.scheduled_sync()
        except Exception as e:
            log(f"scheduled sync failed: {e!r}")
        try:
            bot.suggest_cam()
        except Exception as e:
            log(f"cam suggestion failed: {e!r}")
        try:
            bot.refresh_status()
        except Exception as e:  # the pinned conditions are nice to have
            log(f"pinned conditions update failed: {e!r}")
        since, first = resp["next_batch"], False
        save_state(state, since)


if __name__ == "__main__":
    main()
