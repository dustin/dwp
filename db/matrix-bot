    t = hst(epoch)
    return f"{t:%H:%M}" if t.date() == datetime.now(HST).date() else f"{t:%a %H:%M}"


WEATHER = None  # a Weather once main starts it: live readings over MQTT
LIVE_KEY = "live/wind.json"  # outside publish's prefixes, so orphans leaves it be
LIVE_EVERY = 30  # at most one write of it per this many seconds
LIVE_HEADERS = ["Content-Encoding: gzip", "Content-Type: application/json",
                "Cache-Control: public, max-age=30"]


def seed_weather(weather):
    """The lake's last day of wind under the live feed, so a restart
    doesn't start the live object over empty."""
    by = {}
    for r in query("select site, epoch(ts) as t, wavg, wdir, wgust, wlull from wind "
                   "where ts > now() - interval 1 day and wavg is not null order by ts"):
        by.setdefault(r.pop("site"), []).append(r)
    for site, rows in by.items():
        weather.seed(site, rows)
    log(f"seeded live wind from the lake: {', '.join(f'{s} {len(r)}' for s, r in by.items())}")


def write_live(weather, dry_run=False):
    """Keep LIVE_KEY in the bucket replaced with weather's last 24 hours,
    within LIVE_EVERY seconds of each new reading. Runs in its own thread."""
    while True:
        weather.changed.wait()
        weather.changed.clear()
        body = gzip.compress(json.dumps(weather.snapshot(), separators=(",", ":")).encode(),
                             mtime=0)
        args = ["rclone", "rcat", dwp_publish.DEST + LIVE_KEY]
        for h in LIVE_HEADERS:
            args += ["--header-upload", h]
        if dry_run:
            log(f"would write {LIVE_KEY}: {len(body)} bytes")
        else:
            r = subprocess.run(args, input=body, capture_output=True)
            if r.returncode != 0:
                log(f"writing {LIVE_KEY} failed: {r.stderr.decode(errors='replace').strip()}")
        time.sleep(LIVE_EVERY)


def wind_now():
    """Per station with readings in the last day: (site, latest reading,
    its average an hour earlier), in WIND_ORDER. The lake's readings, then
    the live feed's newer ones on top."""
    rows = query("select site, epoch(ts) as t, wavg, wdir, wgust, wlull from wind "
                 "where ts > now() - interval 1 day and wavg is not null order by ts")
    by = {}
    for r in rows:
        by.setdefault(r["site"], []).append(r)
    for site, live in (WEATHER.recent() if WEATHER else {}).items():
        rs = by.setdefault(site, [])
        newest = rs[-1]["t"] if rs else 0
        rs += [r for r in live if r["t"] > newest]
    out = []
    for site, rs in by.items():
        last = rs[-1]
        hour_ago = [r["wavg"] for r in rs if 3000 <= last["t"] - r["t"] <= 4200]
        out.append((site, last, sum(hour_ago) / len(hour_ago) if hour_ago else None))
    return sorted(out, key=lambda x: (WIND_ORDER.index(x[0]) if x[0] in WIND_ORDER
                                      else len(WIND_ORDER), -x[1]["t"]))


def wind_line(site, r, before):
    # Any of direction, gust and lull can be missing (Wailea's feed has no
    # lull, and a station's row can lack gust or direction).
    s = (f"{site_name(site)} {r['wavg']:.0f} kn"
         + (f" {spectrum_svg.compass(r['wdir'])} ({r['wdir']:.0f}°)" if r.get("wdir") is not None else "")
         + (f", gusts {r['wgust']:.0f}" if r.get("wgust") is not None else "")
         + (f" / lulls {r['wlull']:.0f}" if r.get("wlull") is not None else ""))
    if before is not None:
        d = r["wavg"] - before
        s += (f" · building from {before:.0f}" if d >= 3 else
              f" · dropping from {before:.0f}" if d <= -3 else " · steady")
    return s + f" · {'live ' if r.get('live') else ''}{when(r['t'])}"


def tide_line():
    """Kihei's tides today, from the live feed's aux2: "low 09:52 0.6 ft ·
    high 15:24 1.7 ft", the next one marked."""
    ts = tides(WEATHER.info("kihei").get("aux2")) if WEATHER else []
    if not ts:
        return None
    now = time.time()
    nxt = next((t for t, _, _ in ts if t > now), None)
    return "Kihei tide: " + " · ".join(
        f"{'next ' if t == nxt else ''}{'high' if hl == 'H' else 'low'} {hst(t):%H:%M} {ft:.1f} ft"
        for t, hl, ft in ts)


def swells_now():
    """Per buoy with a reading in the last day: (site, epoch, [(ft, s, °, kJ)])
    from swell_partition's latest full reading, rank 1 (NDBC's own) first.
    The spectral components (rank 2+) come with the :56 readings, so a
    newer reading with rank 1 alone loses to the one before it. kJ is the
    Surfline-style figure the web shows: rank 1's surfline_kj for the whole
    reading, and each component's share of it (swellKJShares in
    web/lib/components/spectral-partitions.js); None when there's no total."""
    rows = query("with latest as (select site, arg_max(ts, (n > 1)::int * 1e10 + epoch(ts)) as ts "
                 "from (select site, ts, count(*) as n from swell_partition "
                 "where ts > now() - interval 1 day group by all) group by site) "
                 "select p.site, epoch(p.ts) as t, p.rank, p.height, p.period, p.direction, "
                 "p.energy, p.surfline_kj "
                 "from swell_partition p join latest using (site, ts) order by p.site, p.rank")
    by = {}
    for r in rows:
        if r["height"] and r["period"] and r["direction"] is not None:
            by.setdefault((r["site"], r["t"]), []).append(r)
    out = []
    for (site, t), rs in by.items():
        total = next((r["surfline_kj"] for r in rs if r["rank"] == 1), None)
        parts = [r for r in rs if r["rank"] > 1]
        raw = [(r["energy"] or 0) * G * r["period"] ** 2 / math.pi for r in parts]
        scale = total / sum(raw) if total is not None and sum(raw) > 0 else None
        kj = {id(r): k * scale if scale else None for r, k in zip(parts, raw)}
        out.append((site, t, [(r["height"] * 3.28084, r["period"], r["direction"],
                               total if r["rank"] == 1 else kj[id(r)]) for r in rs]))
    return out


def swell_text(swells, n=3):
    return ", ".join(f"{ft:.1f} ft {per:.0f} s {spectrum_svg.compass(d)}"
                     if per >= 10 else f"{ft:.1f} ft {per:.1f} s {spectrum_svg.compass(d)}"
                     for ft, per, d, _ in swells[:n])


def swell_kj_text(swells, n=4):
    """swell_text with each swell's kJ, as the web's buoy cards show it."""
    return ", ".join(swell_text([sw], 1) + (f" ({sw[3]:.0f} kJ)" if sw[3] is not None else "")
                     for sw in swells[:n])


def spectrum_rows(site, epoch):
    return [(r["freq"], r["energy"], r["direction"]) for r in query(
        f"select freq, energy, direction from swell_spectrum where site = {sql_str(site)} "
        f"and ts = to_timestamp({epoch}) order by freq")]


def nearest_spectrum(site, epoch):
    """The epoch of the buoy's spectrum within an hour of epoch, or None."""
    near = query(f"select epoch(ts) as t from swell_spectrum where site = {sql_str(site)} "
                 f"and ts between to_timestamp({epoch - 3600}) and to_timestamp({epoch + 3600}) "
                 f"order by abs(epoch(ts) - {epoch}) limit 1")
    return near[0]["t"] if near else None


def spectrum_png(site, epoch, swells):
    """PNG bytes of the buoy's spectrum at epoch, with the reading nearest
    six hours before it dashed over it; None if there's no spectrum."""
    epoch = nearest_spectrum(site, epoch)
    if epoch is None:
        return None
    rows = spectrum_rows(site, epoch)
    prev = query(f"select epoch(ts) as t from swell_spectrum where site = {sql_str(site)} "
                 f"and ts between to_timestamp({epoch - 7 * 3600}) and to_timestamp({epoch - 5 * 3600}) "
                 f"order by abs(epoch(ts) - {epoch - 6 * 3600}) limit 1")
    earlier = spectrum_rows(site, prev[0]["t"]) if prev else None
    t = hst(epoch)
    title = f"{site_name(site)} {t:%a %b} {t.day} {t:%H:%M} · {swell_text(swells)}"
    label = f"{hst(prev[0]['t']):%H:%M} (6h earlier)" if prev else ""
    return spectrum_svg.to_png(spectrum_svg.spectrum_svg(rows, title, earlier, label))


def status_line():
    """One line of the latest conditions, for the bot's pinned message."""
    wind = wind_now()
    parts = [f"{site_name(s)} {r['wavg']:.0f}"
             + (f"g{r['wgust']:.0f}" if r.get("wgust") is not None else "") + " kn"
             + (f" {spectrum_svg.compass(r['wdir'])}" if r.get("wdir") is not None else "")
             for s, r, _ in wind]
    parts += [f"{site_name(s)} {swell_text(sw, 2)}"
              + (f" {sw[0][3]:.0f} kJ" if sw[0][3] is not None else "") for s, _, sw in swells_now()]
    if wind:
        parts.append(f"as of {when(max(r['t'] for _, r, _ in wind))}")
    return " · ".join(parts)


def fresh_cam(site="wailea"):
    """The site's cam reading if it's recent and in daylight, else None."""
    cam = WEATHER.cam(site) if WEATHER else None
    if cam and cam["daylight"] and time.time() - cam["t"] < CAM_STALE:
        return cam
    return None


def cam_line(cam, site="wailea"):
    return (f"{site_name(site)} cam: {cam['sea']}"
            + (f", shorebreak {cam['shorebreak']}" if cam["shorebreak"] else "")
            + f" · {when(cam['t'])}")


def send_cam_frame(mx, room, cam, cache, reply_to=None):
    """Post the frame the cam reading was made from, if Node-RED gave its
    URL (fetched from here, so a LAN address is fine); cache maps the
    reading's time to its upload, so it goes up once."""
    if not cam.get("image"):
        return
    if cam["t"] not in cache:
        try:
            with urllib.request.urlopen(cam["image"], timeout=20) as r:
                jpg = r.read()
        except (OSError, urllib.error.URLError) as e:
            log(f"cam frame {cam['image']}: {e}")
            return
        cache.clear()
        cache[cam["t"]] = (mx.upload(jpg, "wailea-cam.jpg", "image/jpeg"), len(jpg))
    mxc, size = cache[cam["t"]]
    mx.image(room, mxc, "wailea-cam.jpg", size, 1920, 1080, reply_to=reply_to, mimetype="image/jpeg")


def escape(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def rating_line():
    """Node-RED's best bet and both sides' scores, or None if there's no
    rating newer than run_alerts.STALE."""
    r = WEATHER.rating if WEATHER else None
    if not r or time.time() - r["t"] > run_alerts.STALE:
        return None
    scores = ", ".join(f"{name} {run_alerts.out_of_10(r[side])}" for side, name in run_alerts.SIDES.items())
    return f"Best bet: {r['rec'][:1].upper() + r['rec'][1:]} · {scores} ({when(r['t'])})"


def conditions(mx, room, event_id, images, frames, charts=False):
    """Reply with the run rating, wind and buoys, the cam frame and, with
    charts, each buoy's spectrum image. images caches (site, epoch) ->
    uploaded mxc, so asking again before the next reading doesn't upload
    the same picture again."""
    lines, cam = [], fresh_cam()
    best = rating_line()
    if best:
        lines.append(("🏄 ", best))
    for w in wind_now():
        lines.append(("🌬️ ", wind_line(*w)))
        if w[0] == "wailea" and cam:  # the cam goes under Wailea's wind
            lines.append(("📷 ", cam_line(cam)))
    if cam and not any(a == "📷 " for a, _ in lines):
        lines.append(("📷 ", cam_line(cam)))
    tide = tide_line()
    if tide:
        lines.append(("↕️ ", tide))
    buoys = swells_now()
    lines += [("🌊 ", f"{site_name(s)} {when(t)}: {swell_kj_text(sw)}") for s, t, sw in buoys]
    if not lines:
        mx.notice(room, "No wind or buoy readings in the last day.", reply_to=event_id)
        return
    mx.notice(room, "\n".join(a + b for a, b in lines), reply_to=event_id,
              html="<br>".join(a + (f'<a href="{CAM_PAGE}">{escape(b)}</a>' if a == "📷 " else escape(b))
                               for a, b in lines))
    if cam:
        send_cam_frame(mx, room, cam, frames, reply_to=event_id)
    for site, t, sw in buoys if charts else ():
        key = (site, t)
        if key not in images:
            try:
                png = spectrum_png(site, t, sw)
            except (OSError, subprocess.CalledProcessError) as e:
                log(f"spectrum image failed: {e}")
                continue
            if not png:
                continue
            images[key] = (mx.upload(png, f"{site}-spectrum.png", "image/png"), len(png))
        mxc, size = images[key]
        mx.image(room, mxc, f"{site}-spectrum.png", size, 1800, 760, reply_to=event_id)


# --- the room -------------------------------------------------------------

def is_gpx(c):
    name = (c.get("filename") or c.get("body") or "").lower()
    return c.get("msgtype") == "m.file" and "url" in c and (
        name.endswith(".gpx") or "gpx" in c.get("info", {}).get("mimetype", ""))


def caption(c):
    """A file's caption (Matrix 1.10: a body that differs from filename)."""
    fn, body = c.get("filename"), c.get("body", "")
    return body.strip() if fn and body != fn else ""


FOIL = re.compile(r"^(-|[\w .'-]{1,60})$")


class Bot:
    def __init__(self, mx, args):
        self.mx, self.args = mx, args
        self.pending = {}  # sender -> (event_id, gpx path, received at)
        self.tmp = tempfile.mkdtemp(prefix="dwp-matrix-")
        self.images = {}  # (buoy, reading epoch) -> (mxc, size): see conditions
        self.frames = {}  # cam reading time -> (mxc, size): see send_cam_frame
        self.status, self.status_at, self.edited = None, 0, 0

    def refresh_status(self):
        """Every STATUS_EVERY seconds, edit the latest conditions into the
        bot's pinned message (Element X shows it in a banner atop the room),
        if they've changed (not just their time) and it's been EDIT_EVERY
        since the last edit, posting it the first time and pinning it again
        if someone unpinned it. Each edit is an event in the room, so
        fewer of them is less churn for everyone's clients."""
        if time.time() - self.status_at < STATUS_EVERY:
            return
        self.status_at = time.time()
        line = status_line()
        if not line:
            return
        room, path = self.args.room, os.path.join(self.args.state_dir, "pinned")
        pinned, now = load_state(path), time.time()
        if not pinned:
            pinned = self.mx.notice(room, line)
            if not pinned:
                return
            save_state(path, pinned)
            self.status, self.edited = line, now
        elif (line.split(" · as of ")[0] != (self.status or "").split(" · as of ")[0]
              and now - self.edited >= EDIT_EVERY):
            self.mx.edit(room, pinned, line)
            self.status, self.edited = line, now
        # The message is saved before it's pinned, so a bot without the
        # power to pin (403) keeps editing its one message rather than
        # posting a new one every few minutes.
        if pinned not in self.mx.pinned(room):
            self.mx.pin(room, pinned)

    def announce_ratings(self):
        """Tell the room when a run's getting good (see run_alerts.py), as
        plain text rather than a notice, so it notifies like a person would."""
        if not WEATHER:
            return
        if not hasattr(self, "alerts"):
            self.alerts = run_alerts.Alerts(os.path.join(self.args.state_dir, "rating.json"))
        while not WEATHER.ratings.empty():
            rating = WEATHER.ratings.get()
            said = self.alerts.see(rating)
            if not said:
                continue
            wind = {site: wind_line(site, r, before) for site, r, before in wind_now()}
            cam = fresh_cam()
            lines = {"kihei": [wind[s] for s in ("kihei", "wailea") if s in wind]
                     + ([cam_line(cam)] if cam else []),
                     "ns": [wind[s] for s in ("hookipa",) if s in wind]}
            for kind, sides in said:
                self.mx.send(self.args.room, {"msgtype": "m.text", "body": run_alerts.message(
                    kind, sides, rating, lines)})

    def suggest_cam(self):
        """Once a Hawaii day, when Kīhei's rating reaches LOOK and the Wailea
        cam reads LIVELY (both fresh), suggest a look at the cam."""
        cam, rating = fresh_cam(), WEATHER.rating if WEATHER else None
        if not cam or cam["sea"] not in LIVELY or not rating:
            return
        if time.time() - rating["t"] > run_alerts.STALE or rating["kihei"] < LOOK:
            return
        path, today = os.path.join(self.args.state_dir, "cam-nudge"), f"{hst(time.time()):%F}"
        if load_state(path) == today:
            return
        save_state(path, today)
        text = (f"👀 The Wailea cam shows {cam['sea']} and Kīhei is at "
                f"{run_alerts.out_of_10(rating['kihei'])}. Worth a look: {CAM_PAGE}")
        self.mx.send(self.args.room, {"msgtype": "m.text", "body": text, "format": "org.matrix.custom.html",
                                      "formatted_body": escape(text).replace(
                                          CAM_PAGE, f'<a href="{CAM_PAGE}">{CAM_PAGE}</a>')})
        send_cam_frame(self.mx, self.args.room, cam, self.frames)

    def handle(self, ev):
        room = self.args.room
        c = ev.get("content", {})
        if ev.get("type") == "m.room.encrypted":
            self.mx.notice(room, "This room is encrypted, and I can only read "
                                 "unencrypted rooms.")
            return
        if ev.get("type") != "m.room.message" or "m.relates_to" in c and \
                c["m.relates_to"].get("rel_type") == "m.replace":
            return
        eid, sender = ev["event_id"], ev["sender"]
        rider = self.args.users.get(sender)
        text = c.get("body", "").strip() if c.get("msgtype") == "m.text" else ""
        if text.startswith("!conditions"):  # anyone in the room
            conditions(self.mx, room, eid, self.images, self.frames,
                       charts="chart" in text[len("!conditions"):])
            return
        if text.startswith("!help") and not rider:
            body, html = help_text([("Anyone", HELP_ANYONE)])
            self.mx.notice(room, body, reply_to=eid, html=html)
            return
        if not rider:
            return
        if is_gpx(c):
            fd, path = tempfile.mkstemp(suffix=".gpx", dir=self.tmp)
            try:
                with os.fdopen(fd, "wb") as fh:
                    fh.write(self.mx.download(c["url"]))
            except (urllib.error.URLError, OSError) as e:
                self.mx.notice(room, f"❌ couldn't download that file: {e}", reply_to=eid)
                return
            foil = caption(c)
            if sender in self.pending:  # a newer file replaces one still waiting
                os.unlink(self.pending.pop(sender)[1])
            if foil and FOIL.match(foil):
                self.attempt(sender, eid, path, foil, rider)
            else:
                self.pending[sender] = (eid, path, time.time())
                self.mx.notice(room, "Which foil? (e.g. 585, or - for your last "
                                     "one from that beach)", reply_to=eid)
            return
        if c.get("msgtype") != "m.text":
            return
        text = c.get("body", "").strip()
        if text.startswith("!sync"):
            riders = text.split()[1:]
            if not self.room_admin(sender):
                if riders and riders != [rider]:
                    self.mx.notice(room, "You can only sync yourself.", reply_to=eid)
                    return
                riders = [rider]
            if all(RIDER.fullmatch(r) for r in riders):
                strava_sync(self.mx, room, eid, riders)
            else:
                self.mx.notice(room, "!sync takes rider names, like !sync walter",
                               reply_to=eid)
        elif text.startswith("!last"):
            who = text.split()[1:2] or [rider]
            r = latest(who[0]) if RIDER.fullmatch(who[0]) else None
            if r:
                body, html = summary(r, who[0])
                self.mx.notice(room, body, reply_to=eid, html=html)
            else:
                self.mx.notice(room, f"No runs for {who[0]}.", reply_to=eid)
        elif text.startswith("!foil"):
            words = text.split()[1:]
            target = rider
            if len(words) > 1 and words[0] in self.riders():
                if words[0] != rider and not self.room_admin(sender):
                    self.mx.notice(room, "You can only change your own runs.",
                                   reply_to=eid)
                    return
                target, words = words[0], words[1:]
            name = " ".join(words)
            if FOIL.match(name):
                set_foil(self.mx, room, eid, target, name)
            else:
                self.mx.notice(room, "!foil takes a foil, like !foil 585 "
                                     "(or !foil walter orca 685)", reply_to=eid)
        elif text.startswith("!publish"):
            words = text.split()[1:]
            if not self.room_admin(sender):
                self.mx.notice(room, "Only room admins can publish.", reply_to=eid)
            elif not set(words) <= PUBLISH_WORDS or words[1:] and \
                    set(words[1:]) & {"publish", "verify", "orphans"}:
                self.mx.notice(room, "!publish takes ./publish's words: [verify | orphans] "
                                     "[--dry-run] [--fix] [--delete] [--force]",
                               reply_to=eid)
            else:
                publish(self.mx, room, eid, words)
        elif text.startswith("!help"):
            sections = [("Anyone", HELP_ANYONE), ("Your runs", HELP_RIDER)]
            admin = self.room_admin(sender)
            if admin:  # their bare !sync syncs everyone
                sections = [("Anyone", HELP_ANYONE),
                            ("Your runs", [h for h in HELP_RIDER if h[0] != "!sync"]),
                            ("Room admins: any rider", HELP_ADMIN),
                            ("Room admins: publishing", HELP_ROOM_ADMIN)]
            body, html = help_text(sections)
            self.mx.notice(room, body, reply_to=eid, html=html)
        elif sender in self.pending and FOIL.match(text):
            gpx_eid, path, at = self.pending.pop(sender)
            if time.time() - at < PENDING_TTL:
                self.attempt(sender, gpx_eid, path, text, rider)
            else:
                os.unlink(path)

    def room_admin(self, sender):
        """Whether sender has admin power (100) in the room, read fresh."""
        pl = self.mx.call("GET", f"/_matrix/client/v3/rooms/{urllib.parse.quote(self.args.room)}"
                                 "/state/m.room.power_levels")
        return pl.get("users", {}).get(sender, pl.get("users_default", 0)) >= 100

    def riders(self):
        """Every rider: the users' and any others with runs in the lake."""
        return set(self.args.users.values()) | {
            row["rider"] for row in query(
                "select distinct rider from dwlist where rider is not null")}

    def attempt(self, sender, eid, path, foil, rider):
        """Import; if that fails, the file waits for another foil."""
        if import_gpx(self.mx, self.args.room, eid, path, foil, rider):
            os.unlink(path)
        else:
            self.pending[sender] = (eid, path, time.time())


def load_state(path):
    try:
        with open(path) as fh:
            return fh.read().strip() or None
    except FileNotFoundError:
        return None


def save_state(path, since):
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        fh.write(since)
    os.replace(tmp, path)


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--homeserver", required=True,
                    help="server name (e.g. sallings.org) or client API URL")
    ap.add_argument("--room", required=True, help="room id, e.g. !abc:matrix.org")
    ap.add_argument("--user", action="append", required=True, metavar="MXID=RIDER",
                    help="a Matrix user it listens to, and whose runs their GPX files "
                         "are, e.g. @dustin:sallings.org=dustin (repeatable)")
    ap.add_argument("--admin", action="append", default=[], metavar="MXID",
                    help=argparse.SUPPRESS)  # ignored: room power levels decide now
    ap.add_argument("--token-file", default="~/.config/dwp/matrix-token",
                    help="the bot account's access token")
    ap.add_argument("--state-dir", default="~/.local/state/dwp-matrix-bot")
    ap.add_argument("--mqtt", default="mqtt", metavar="HOST[:PORT]",
                    help="broker with the weather/+ station feed (\"\" for none)")
    args = ap.parse_args(argv)
    args.users = {}
    for u in args.user:
        mxid, _, rider = u.partition("=")
        if not mxid.startswith("@") or not RIDER.fullmatch(rider):
            ap.error(f"--user wants @someone:server=rider, not {u}")
        args.users[mxid] = rider

    with open(os.path.expanduser(args.token_file)) as fh:
        mx = Matrix(client_url(args.homeserver), fh.read().strip())
    state_dir = args.state_dir = os.path.expanduser(args.state_dir)
    os.makedirs(state_dir, exist_ok=True)
    state = os.path.join(state_dir, "since")
    bot = Bot(mx, args)
    if args.mqtt:
        global WEATHER
        host, _, port = args.mqtt.partition(":")
        WEATHER = Weather(host, int(port or 1883))
        try:
            seed_weather(WEATHER)
        except Exception as e:  # live wind without history beats none
            log(f"seeding live wind failed: {e!r}")
        WEATHER.start()
        threading.Thread(target=write_live, args=(WEATHER,), name="live", daemon=True).start()

    me = mx.call("GET", "/_matrix/client/v3/account/whoami")["user_id"]
    log(f"{me} listening to {', '.join(args.users)} in {args.room}")
    filt = json.dumps({"room": {"rooms": [args.room], "timeline": {"limit": 50},
                                "state": {"lazy_load_members": True}},
                       "presence": {"not_types": ["*"]},
                       "account_data": {"not_types": ["*"]}})
    since = load_state(state)
    first = since is None
    backoff = 5
    while True:
        params = {"filter": filt, "timeout": 0 if first else 30000}
        if since:
            params["since"] = since
        try:
            resp = mx.call("GET", "/_matrix/client/v3/sync", params=params, timeout=90)
        except (urllib.error.URLError, OSError, json.JSONDecodeError) as e:
            log(f"sync failed: {e}; retrying in {backoff}s")
            time.sleep(backoff)
            backoff = min(backoff * 2, 300)
            continue
        backoff = 5
        rooms = resp.get("rooms", {})
        if args.room in rooms.get("invite", {}):
            log(f"joining {args.room}")
            mx.call("POST", f"/_matrix/client/v3/join/{urllib.parse.quote(args.room)}", {})
        if not first:  # the first sync only finds where "now" is
            timeline = rooms.get("join", {}).get(args.room, {}).get("timeline", {})
            for ev in timeline.get("events", []):
                if ev.get("sender") != me:
                    try:
                        bot.handle(ev)
                    except Exception as e:  # keep listening whatever one message does
                        log(f"error handling {ev.get('event_id')}: {e!r}")
                        mx.notice(args.room, f"❌ {e!r}")
        try:
            bot.announce_ratings()
        except Exception as e:
            log(f"run alert failed: {e!r}")
        try:
            bot.suggest_cam()
        except Exception as e:
            log(f"cam suggestion failed: {e!r}")
        try:
            bot.refresh_status()
        except Exception as e:  # the pinned conditions are nice to have
            log(f"pinned conditions update failed: {e!r}")
        since, first = resp["next_batch"], False
        save_state(state, since)


if __name__ == "__main__":
    main()
