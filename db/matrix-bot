#!/usr/bin/env python3
"""Import runs (and kick Strava syncs) from a Matrix room.

    ./matrix-bot --homeserver sallings.org --room '!abc:sallings.org' \
        --user @dustin:sallings.org=dustin --user @walter:matrix.org=walter \
        --admin @dustin:sallings.org

Listens in one room, to the Matrix users --user maps to riders:

  * a .gpx file, captioned with a foil ("585"), is imported with add-run
    as the sender's run, then the reply links it. Sent without a caption,
    the bot asks for the foil; answer with one, or "-" for the rider's
    last foil from that start beach. A foil they haven't used before
    takes its full name after "new": "new Axis Spitfire 1180".
  * "!sync" runs strava/sync run for the sender's rider. An --admin's
    "!sync" syncs every rider, and "!sync walter" just Walter.
  * "!last" summarizes the sender's latest run, "!last walter" Walter's.
    Imports reply with the same summary.
  * "!foil 585" changes the foil on the sender's latest run (matched like
    add-run's, or "new <full name>"), then re-exports. An --admin can
    name a rider first: "!foil walter orca 685".
  * "!help" says the above.

Start it from db's nix dev shell (or the flake's matrix-bot package, which
the home-manager module runs). It reads the bot account's access token
from --token-file (default ~/.config/dwp/matrix-token, mode 600) and
remembers where it got to in --state-dir, so a restart neither replays
old files nor misses ones sent while it was down. Use an unencrypted
room: it doesn't speak E2EE.

Only the Python standard library, like the rest of db/.
"""

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime
from zoneinfo import ZoneInfo

DB_DIR = os.path.dirname(os.path.abspath(__file__))
LAKE_DIR = os.environ.get("LAKE") or os.path.expanduser("~/stuff/duck")
PENDING_TTL = 30 * 60  # how long an uncaptioned GPX waits for its foil
HELP = ("Send a .gpx captioned with the foil (e.g. 585) to import it as your run; "
        "without a caption I'll ask. \"-\" for the foil reuses your last one "
        "from that beach; \"new Axis Spitfire 1180\" records a foil you haven't "
        "used before. !foil 585 changes your latest run's foil. !last shows your latest run (!last walter for someone else's); "
        "!sync runs your Strava sync.")
RIDER = re.compile(r"[a-z][a-z0-9-]*")


def log(msg):
    print(f"{time.strftime('%F %T')} {msg}", file=sys.stderr, flush=True)


class Matrix:
    def __init__(self, homeserver, token):
        self.base = homeserver.rstrip("/")
        self.token = token
        self.txn = int(time.time() * 1000)

    def call(self, method, path, body=None, params=None, raw=False, timeout=60):
        url = self.base + path
        if params:
            url += "?" + urllib.parse.urlencode(params)
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(url, data=data, method=method,
                                     headers={"Authorization": f"Bearer {self.token}",
                                              "Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.read() if raw else json.load(r)

    def send(self, room, content, kind="m.room.message"):
        self.txn += 1
        path = (f"/_matrix/client/v3/rooms/{urllib.parse.quote(room)}"
                f"/send/{kind}/{self.txn}")
        try:
            self.call("PUT", path, content)
        except (urllib.error.URLError, OSError) as e:
            log(f"send failed: {e}")

    def notice(self, room, text, reply_to=None, html=None):
        content = {"msgtype": "m.notice", "body": text}
        if html:
            content.update(format="org.matrix.custom.html", formatted_body=html)
        if reply_to:
            content["m.relates_to"] = {"m.in_reply_to": {"event_id": reply_to}}
        self.send(room, content)

    def react(self, room, event_id, key):
        self.send(room, {"m.relates_to": {"rel_type": "m.annotation",
                                          "event_id": event_id, "key": key}},
                  kind="m.reaction")

    def download(self, mxc):
        server, media = mxc[len("mxc://"):].split("/", 1)
        tail = f"/download/{urllib.parse.quote(server)}/{urllib.parse.quote(media)}"
        try:  # authenticated media (Matrix 1.11), then the old unauthenticated path
            return self.call("GET", "/_matrix/client/v1/media" + tail, raw=True)
        except urllib.error.HTTPError as e:
            if e.code not in (400, 404, 405):
                raise
            return self.call("GET", "/_matrix/media/v3" + tail, raw=True)


def client_url(homeserver):
    """The client API base for a server name (e.g. sallings.org), from its
    .well-known; a full https:// URL is taken as is."""
    if "://" in homeserver:
        return homeserver
    try:
        with urllib.request.urlopen(f"https://{homeserver}/.well-known/matrix/client",
                                    timeout=30) as r:
            return json.load(r)["m.homeserver"]["base_url"]
    except (urllib.error.URLError, OSError, KeyError, ValueError) as e:
        log(f"no .well-known for {homeserver} ({e}), trying it directly")
        return f"https://{homeserver}"


# --- the work -------------------------------------------------------------

def run(cmd, env=None, cwd=DB_DIR):
    """Run cmd (in db/ by default); (ok, combined output)."""
    log("+ " + " ".join(cmd))
    r = subprocess.run(cmd, cwd=cwd, env=env, stdout=subprocess.PIPE,
                       stderr=subprocess.STDOUT, text=True)
    sys.stderr.write(r.stdout)
    return r.returncode == 0, r.stdout


def query(sql):
    """Rows of a query against the lake, as dicts."""
    r = subprocess.run(["duckdb", "--init", "init.sql", "-json", "-c", "use lake; " + sql],
                       cwd=LAKE_DIR, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                       text=True)
    out = r.stdout[r.stdout.find("["):] if "[" in r.stdout else "[]"
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return []


def runs(rider):
    """The rider's run ids."""
    return {row["id"] for row in query(
        f"select id::varchar as id from dwlist where rider = '{rider}'")}


# --- run summaries ----------------------------------------------------------

DRY_LIMIT = 0.97  # dryLimit in web/lib/components/data.js
HST = ZoneInfo("Pacific/Honolulu")


def latest(rider, dwid=None):
    """A run's summary fields: dwid's, else the rider's latest."""
    which = f"id = '{dwid}'" if dwid else f"rider = '{rider}' order by ts desc limit 1"
    rows = query(
        "select id::varchar as id, ts, start_beach, end_beach, foil, distance_km, "
        "distance_on_foil, duration_on_foil, avg_foiling_hr, min_foiling_hr, max_speed_1k, "
        f"longest_segment_distance from dwlist_resolved where {which}")
    return rows[0] if rows else None


def dur(sec):
    h, m = divmod(round(sec / 60), 60)
    return f"{h}h {m:02d}m" if h else f"{m}m"


def pace(kmh):
    m, s = divmod(round(3600 / kmh), 60)
    return f"{m}:{s:02d}/km"


def summary(r, rider):
    """(text, html) describing run r."""
    when = datetime.fromtimestamp(r["ts"], HST)
    head = (f"{r['start_beach']} → {r['end_beach']} · "
            f"{when:%a %b} {when.day} {when:%H:%M}")
    lines = []
    foil_m, foil_s = r.get("distance_on_foil"), r.get("duration_on_foil")
    if foil_m and foil_s:
        lines.append(f"🏄 {foil_m / 1000:.1f} km on foil in {dur(foil_s)}")
        lines.append(f"⚡ {foil_m / foil_s * 3.6:.1f} km/h foiling"
                     + (f" · best km {pace(r['max_speed_1k'])}" if r.get("max_speed_1k") else ""))
    elif r.get("distance_km"):
        lines.append(f"📏 {r['distance_km']:.1f} km")
    if r.get("avg_foiling_hr"):
        lines.append(f"❤️ {r['avg_foiling_hr']:.0f} avg · {r['min_foiling_hr']:.0f} min bpm")
    if foil_m and r.get("longest_segment_distance") is not None:
        frac = r["longest_segment_distance"] / foil_m
        lines.append("★ dry!" if frac > DRY_LIMIT
                     else f"💦 not dry: longest flight {frac:.0%} of foiling")
    if r.get("foil"):
        lines.append(f"🪽 {r['foil']}")
    url = f"https://{rider}.downwind.pro/run.html?id={r['id']}"
    text = "\n".join([head, *lines, url])
    html = "<br>".join([f'<a href="{url}"><b>{escape(head)}</b></a>',
                        *map(escape, lines)])
    return text, html


def tail(out, n=15):
    return "\n".join(out.rstrip().splitlines()[-n:])


def import_gpx(mx, room, event_id, path, foil, rider):
    mx.react(room, event_id, "👀")
    before = runs(rider)
    cmd = ["./add-run", path, "--rider", rider]
    new_foil = re.match(r"new\s+(.+)", foil, re.I)
    if new_foil:
        cmd[2:2] = [new_foil.group(1), "--new-foil"]
    elif foil and foil != "-":
        cmd.insert(2, foil)
    ok, out = run(cmd)
    if not ok:
        why = next((ln for ln in reversed(out.splitlines())
                    if "foil matches" in ln or "foil from" in ln), None)
        if why:  # the foil lookup failed: ask again, the file waits
            why = why.split("Error: ")[-1].strip()
            mx.notice(room, f"🤔 {why}\nWhich foil? If it's one you haven't ridden "
                            "before, send its full name after \"new\", e.g. "
                            "new Axis Spitfire 1180.", reply_to=event_id)
        else:
            mx.notice(room, f"❌ add-run failed:\n{tail(out)}", reply_to=event_id,
                      html=f"❌ add-run failed:<pre><code>{escape(tail(out))}</code></pre>")
        return False
    new = runs(rider) - before
    r = latest(rider, new.pop()) if len(new) == 1 else None
    if not r:
        mx.notice(room, "✅ imported (couldn't tell which run it is)", reply_to=event_id)
        return True
    text, html = summary(r, rider)
    mx.notice(room, "✅ " + text, reply_to=event_id, html="✅ " + html)
    return True


def sql_str(v):
    return "'" + v.replace("'", "''") + "'"


def resolve_foil(rider, name):
    """(foil, None) for the one known foil name names, else (None, why).

    Matches like import.sql: a case-insensitive piece of the name, an exact
    name always winning; the rider's own foils first, then everyone's (a
    rider whose runs say "unknown" may share a foil with someone else)."""
    new = re.match(r"new\s+(.+)", name, re.I)
    if new:
        return new.group(1).strip(), None
    for where in (f"rider = '{rider}' and ", ""):
        known = [row["foil"] for row in query(
            f"select distinct foil from dwlist where {where}foil is not null")]
        exact = [f for f in known if f.lower() == name.lower()]
        hits = exact or [f for f in known if name.lower() in f.lower()]
        if len(hits) == 1:
            return hits[0], None
        if len(hits) > 1:
            return None, f"'{name}' matches more than one foil: {', '.join(sorted(hits))}"
    return None, f"no foil matches '{name}'"


def set_foil(mx, room, event_id, rider, name):
    """Record foil name on the rider's latest run, then re-export."""
    r = latest(rider)
    if not r:
        mx.notice(room, f"No runs for {rider}.", reply_to=event_id)
        return
    foil, why = resolve_foil(rider, name)
    if why:
        mx.notice(room, f"🤔 {why}. If it's a foil nobody has ridden yet, send its "
                        "full name after \"new\", e.g. !foil new Axis Spitfire 1180.",
                  reply_to=event_id)
        return
    mx.react(room, event_id, "👀")
    sql = ("use lake; begin; "
           f"call lake.set_commit_message('dustin', 'matrix-bot: foil of {r['id']}'); "
           f"update dwlist set foil = {sql_str(foil)} where id = '{r['id']}'; commit;")
    ok, out = run(["duckdb", "--init", "init.sql", "-c", sql], cwd=LAKE_DIR)
    if ok:
        ok, out = run(["./upload-runs.sh"])
    if not ok:
        mx.notice(room, f"❌ couldn't change the foil:\n{tail(out)}", reply_to=event_id,
                  html=f"❌ couldn't change the foil:<pre><code>{escape(tail(out))}</code></pre>")
        return
    text, html = summary(latest(rider, r["id"]), rider)
    was = r.get("foil") or "none"
    mx.notice(room, f"✅ foil was {was}\n{text}", reply_to=event_id,
              html=f"✅ foil was {escape(was)}<br>{html}")


def strava_sync(mx, room, event_id, riders):
    mx.react(room, event_id, "👀")
    ok, out = run(["./strava/sync", "run", *riders])
    summary = next((ln for ln in reversed(out.splitlines()) if ln.startswith("imported ")),
                   "")
    if ok:
        mx.notice(room, f"✅ {summary or 'synced'}", reply_to=event_id)
    else:
        mx.notice(room, f"❌ sync failed:\n{tail(out)}", reply_to=event_id,
                  html=f"❌ sync failed:<pre><code>{escape(tail(out))}</code></pre>")


def escape(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


# --- the room -------------------------------------------------------------

def is_gpx(c):
    name = (c.get("filename") or c.get("body") or "").lower()
    return c.get("msgtype") == "m.file" and "url" in c and (
        name.endswith(".gpx") or "gpx" in c.get("info", {}).get("mimetype", ""))


def caption(c):
    """A file's caption (Matrix 1.10: a body that differs from filename)."""
    fn, body = c.get("filename"), c.get("body", "")
    return body.strip() if fn and body != fn else ""


FOIL = re.compile(r"^(-|[\w .'-]{1,60})$")


class Bot:
    def __init__(self, mx, args):
        self.mx, self.args = mx, args
        self.pending = {}  # sender -> (event_id, gpx path, received at)
        self.tmp = tempfile.mkdtemp(prefix="dwp-matrix-")

    def handle(self, ev):
        room = self.args.room
        c = ev.get("content", {})
        if ev.get("type") == "m.room.encrypted":
            self.mx.notice(room, "This room is encrypted, and I can only read "
                                 "unencrypted rooms.")
            return
        if ev.get("type") != "m.room.message" or "m.relates_to" in c and \
                c["m.relates_to"].get("rel_type") == "m.replace":
            return
        eid, sender = ev["event_id"], ev["sender"]
        rider = self.args.users[sender]
        if is_gpx(c):
            fd, path = tempfile.mkstemp(suffix=".gpx", dir=self.tmp)
            try:
                with os.fdopen(fd, "wb") as fh:
                    fh.write(self.mx.download(c["url"]))
            except (urllib.error.URLError, OSError) as e:
                self.mx.notice(room, f"❌ couldn't download that file: {e}", reply_to=eid)
                return
            foil = caption(c)
            if sender in self.pending:  # a newer file replaces one still waiting
                os.unlink(self.pending.pop(sender)[1])
            if foil and FOIL.match(foil):
                self.attempt(sender, eid, path, foil, rider)
            else:
                self.pending[sender] = (eid, path, time.time())
                self.mx.notice(room, "Which foil? (e.g. 585, or - for your last "
                                     "one from that beach)", reply_to=eid)
            return
        if c.get("msgtype") != "m.text":
            return
        text = c.get("body", "").strip()
        if text.startswith("!sync"):
            riders = text.split()[1:]
            if sender not in self.args.admin:
                if riders and riders != [rider]:
                    self.mx.notice(room, "You can only sync yourself.", reply_to=eid)
                    return
                riders = [rider]
            if all(RIDER.fullmatch(r) for r in riders):
                strava_sync(self.mx, room, eid, riders)
            else:
                self.mx.notice(room, "!sync takes rider names, like !sync walter",
                               reply_to=eid)
        elif text.startswith("!last"):
            who = text.split()[1:2] or [rider]
            r = latest(who[0]) if RIDER.fullmatch(who[0]) else None
            if r:
                body, html = summary(r, who[0])
                self.mx.notice(room, body, reply_to=eid, html=html)
            else:
                self.mx.notice(room, f"No runs for {who[0]}.", reply_to=eid)
        elif text.startswith("!foil"):
            words = text.split()[1:]
            target = rider
            if words and words[0] in self.args.users.values() and len(words) > 1:
                if sender not in self.args.admin and words[0] != rider:
                    self.mx.notice(room, "You can only change your own runs.",
                                   reply_to=eid)
                    return
                target, words = words[0], words[1:]
            name = " ".join(words)
            if FOIL.match(name):
                set_foil(self.mx, room, eid, target, name)
            else:
                self.mx.notice(room, "!foil takes a foil, like !foil 585 "
                                     "(or !foil walter orca 685)", reply_to=eid)
        elif text.startswith("!help"):
            self.mx.notice(room, HELP, reply_to=eid)
        elif sender in self.pending and FOIL.match(text):
            gpx_eid, path, at = self.pending.pop(sender)
            if time.time() - at < PENDING_TTL:
                self.attempt(sender, gpx_eid, path, text, rider)
            else:
                os.unlink(path)

    def attempt(self, sender, eid, path, foil, rider):
        """Import; if that fails, the file waits for another foil."""
        if import_gpx(self.mx, self.args.room, eid, path, foil, rider):
            os.unlink(path)
        else:
            self.pending[sender] = (eid, path, time.time())


def load_state(path):
    try:
        with open(path) as fh:
            return fh.read().strip() or None
    except FileNotFoundError:
        return None


def save_state(path, since):
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        fh.write(since)
    os.replace(tmp, path)


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--homeserver", required=True,
                    help="server name (e.g. sallings.org) or client API URL")
    ap.add_argument("--room", required=True, help="room id, e.g. !abc:matrix.org")
    ap.add_argument("--user", action="append", required=True, metavar="MXID=RIDER",
                    help="a Matrix user it listens to, and whose runs their GPX files "
                         "are, e.g. @dustin:sallings.org=dustin (repeatable)")
    ap.add_argument("--admin", action="append", default=[], metavar="MXID",
                    help="a user whose !sync may name any rider (repeatable)")
    ap.add_argument("--token-file", default="~/.config/dwp/matrix-token",
                    help="the bot account's access token")
    ap.add_argument("--state-dir", default="~/.local/state/dwp-matrix-bot")
    args = ap.parse_args(argv)
    args.users = {}
    for u in args.user:
        mxid, _, rider = u.partition("=")
        if not mxid.startswith("@") or not RIDER.fullmatch(rider):
            ap.error(f"--user wants @someone:server=rider, not {u}")
        args.users[mxid] = rider

    with open(os.path.expanduser(args.token_file)) as fh:
        mx = Matrix(client_url(args.homeserver), fh.read().strip())
    state_dir = os.path.expanduser(args.state_dir)
    os.makedirs(state_dir, exist_ok=True)
    state = os.path.join(state_dir, "since")
    bot = Bot(mx, args)

    me = mx.call("GET", "/_matrix/client/v3/account/whoami")["user_id"]
    log(f"{me} listening to {', '.join(args.users)} in {args.room}")
    filt = json.dumps({"room": {"rooms": [args.room], "timeline": {"limit": 50},
                                "state": {"lazy_load_members": True}},
                       "presence": {"not_types": ["*"]},
                       "account_data": {"not_types": ["*"]}})
    since = load_state(state)
    first = since is None
    backoff = 5
    while True:
        params = {"filter": filt, "timeout": 0 if first else 30000}
        if since:
            params["since"] = since
        try:
            resp = mx.call("GET", "/_matrix/client/v3/sync", params=params, timeout=90)
        except (urllib.error.URLError, OSError, json.JSONDecodeError) as e:
            log(f"sync failed: {e}; retrying in {backoff}s")
            time.sleep(backoff)
            backoff = min(backoff * 2, 300)
            continue
        backoff = 5
        rooms = resp.get("rooms", {})
        if args.room in rooms.get("invite", {}):
            log(f"joining {args.room}")
            mx.call("POST", f"/_matrix/client/v3/join/{urllib.parse.quote(args.room)}", {})
        if not first:  # the first sync only finds where "now" is
            timeline = rooms.get("join", {}).get(args.room, {}).get("timeline", {})
            for ev in timeline.get("events", []):
                if ev.get("sender") in args.users:
                    try:
                        bot.handle(ev)
                    except Exception as e:  # keep listening whatever one message does
                        log(f"error handling {ev.get('event_id')}: {e!r}")
                        mx.notice(args.room, f"❌ {e!r}")
        since, first = resp["next_batch"], False
        save_state(state, since)


if __name__ == "__main__":
    main()
