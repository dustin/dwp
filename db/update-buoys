#!/bin/sh
#
# The half-hourly buoy job (launchd net.spy.buoyupdate on dsstudio):
# Every Hawaiʻi buoy's readings and spectra (swell/collect), the latest
# Pauwela report to MQTT, then forecast-ingest, publish and the MagTag
# render. (cam-ingest runs with the cam watcher, wherever that is: see
# cams/hm-module.nix.)
#
# Runs against the lake in ~/stuff/duck, like add-run; set LAKE to point
# elsewhere.
set -eux
set -o pipefail

PATH=/bin:/usr/bin:$PATH

here=$(cd "$(dirname "$0")" && pwd)
cd "${LAKE:-$HOME/stuff/duck}"

nc -vz -w 3 mqtt 1883 >&2

"$here/swell/collect" 51205 pauwela
"$here/swell/collect" 51201 waimea
"$here/swell/collect" 51212 barbers_point
"$here/swell/collect" 51202 mokapu
"$here/swell/collect" 51206 hilo
"$here/swell/collect" 51001 nw_hawaii
"$here/swell/collect" 51000 n_hawaii
"$here/swell/collect" 51002 sw_hawaii
"$here/swell/collect" 51004 se_hawaii

duckdb --noheader --list --init quack-init.sql < "$here/swell/recent-export.sql" \
    | /usr/bin/curl -sS --data-binary @- mqtt://mqtt/ocean/buoy-update

#   | mosquitto_pub -V 5 -d -h mqtt -t ocean/buoy -r -D publish message-expiry-interval 3600 -s

cd "$here"
./forecast-ingest
./publish

/nix/var/nix/profiles/default/bin/nix develop "$HOME/prog/snippets/circuitpython/trmnl/gen" --command magtag-render https://downwind.pro/magtag.html
