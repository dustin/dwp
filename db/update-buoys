#!/bin/sh
#
# The half-hourly buoy job (services.dwp-buoys, buoys.nix; on pitrick):
# Every Hawaiʻi buoy's readings and spectra (swell/collect), the latest
# Pauwela report to MQTT, then forecast-ingest, wind-ingest and publish. (cam-ingest
# runs with the cam watcher, wherever that is: see cams/hm-module.nix. The
# e-paper displays render from the published data on their own timer:
# display/hm-module.nix.)
#
# Runs against the database DWP_DB points at (default ~/.config/duckq/dwp),
# like add-run. Needs duckdb, curl, nc and python3 on PATH.
set -eux
set -o pipefail

PATH=/bin:/usr/bin:$PATH

here=$(cd "$(dirname "$0")" && pwd)
# DWP_DB: the directory whose quack-init.sql connects to the dwp database.
DWP_DB=${DWP_DB:-$HOME/.config/duckq/dwp}
export DWP_DB
cd "$DWP_DB"

# One step failing (a buoy offline, NDBC or PacIOOS hanging, bee1's
# InfluxDB away) mustn't stop the rest, and above all not the publish at
# the end: dwp/publish/status/ok going stale is what bee1's babysitter
# alerts on. A failed step still fails the job, after the publish.
failed=
step() {
    "$@" || { echo "update-buoys: $* failed (exit $?)" >&2; failed="$failed $1"; }
}

step nc -vz -w 3 mqtt 1883 >&2

for b in "51205 pauwela" "51201 waimea" "51212 barbers_point" "51202 mokapu" \
         "51206 hilo" "51001 nw_hawaii" "51000 n_hawaii" "51002 sw_hawaii" \
         "51004 se_hawaii"; do
    # shellcheck disable=SC2086
    step "$here/swell/collect" $b
done

buoy_update() {
    duckdb --noheader --list --init quack-init.sql < "$here/swell/recent-export.sql" \
        | curl -sS --data-binary @- mqtt://mqtt/ocean/buoy-update
}
step buoy_update

#   | mosquitto_pub -V 5 -d -h mqtt -t ocean/buoy -r -D publish message-expiry-interval 3600 -s

cd "$here"
step ./forecast-ingest
# bee1's InfluxDB being away only stalls the database's wind; publish goes on.
step ./wind-ingest
./publish  # through publishd, wherever that runs

if [ -n "$failed" ]; then
    echo "update-buoys: failed:$failed" >&2
    exit 1
fi
