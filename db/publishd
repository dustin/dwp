#!/usr/bin/env python3
"""The publish service: the one place ./publish runs, on whichever host
runs this.

    ./publishd [--mqtt HOST[:PORT]] [--settle SECONDS] [--every SECONDS]

Every ./publish (any command) and dwp_publish.run() (add-run, the bot,
drive-sync) sends its arguments to dwp/publish/req on the broker
(DWP_MQTT, default mqtt) and waits; publishd runs ./publish with them here
and answers on dwp/publish/reply/<id> with {"ok", "code", "error", "stamp",
"seconds", "output"}, which the caller prints. One request runs at a time.
Plain publishes that arrive within --settle seconds (15) of each other,
or while one is running, are served by one run; --dry-run, verify and
orphans each get their own. After every plain publish,
dwp/publish/status (retained) holds {"ok", "error", "stamp", "seconds",
"host"}, and after one that worked dwp/publish/status/ok holds the same,
for an alert when publishes fail or stop (bee1's babysitter watches it).

With --every, it also publishes after that many seconds without a request.

It needs what publish needs: the lake (LAKE's quack-init.sql), rclone with
the s3 remote (RCLONE_CONFIG), python3 and duckdb.
"""

import argparse
import json
import os
import queue
import socket
import subprocess
import sys
import threading
import time
from collections import deque
from datetime import datetime, timezone

sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
import dwp_mqtt  # noqa: E402
from dwp_publish import REQUEST_TOPIC, REPLY_TOPIC, STATUS_TOPIC  # noqa: E402


def log(msg):
    print(f"{time.strftime('%F %T')} publishd: {msg}", file=sys.stderr, flush=True)


def listen(host, requests):
    """Put each request, (id, args), on requests, reconnecting forever."""
    backoff = 5
    while True:
        began = time.time()
        try:
            with dwp_mqtt.Client(host, [REQUEST_TOPIC], name="dwp-publishd") as c:
                log(f"listening on {host} {REQUEST_TOPIC}")
                for _, payload in c.messages():
                    try:
                        r = json.loads(payload)
                        args = [str(a) for a in r.get("args") or []]
                        requests.put((str(r["id"]), args))
                        log(f"request {r['id']} from {r.get('from', '?')}: publish {' '.join(args)}")
                    except (ValueError, KeyError, TypeError):
                        log(f"ignoring {payload[:200]!r}")
        except (OSError, ConnectionError) as e:
            if time.time() - began > 300:
                backoff = 5
            log(f"{host}: {e}; retrying in {backoff}s")
        time.sleep(backoff)
        backoff = min(backoff * 2, 300)


def publish(args):
    """Run ./publish args here; (exit code, error line, output, seconds)."""
    env = dict(os.environ, DWP_PUBLISH_LOCAL="1")  # it publishes, not asks
    began = time.time()
    r = subprocess.run([sys.executable, os.path.join(HERE, "publish"), *args], env=env,
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    sys.stderr.write(r.stdout)
    lines = r.stdout.strip().splitlines()
    err = None if r.returncode == 0 else (
        next((l for l in reversed(lines) if l.startswith("publish:")), f"exit {r.returncode}"))
    return r.returncode, err, r.stdout, time.time() - began


def answer(host, topic, msg, retain=False):
    try:
        dwp_mqtt.send(host, topic, json.dumps(msg), retain=retain)
    except (OSError, ConnectionError) as e:
        log(f"couldn't send {topic}: {e}")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--mqtt", default=os.environ.get("DWP_MQTT") or "mqtt", help="HOST[:PORT] of the broker")
    ap.add_argument("--settle", type=float, default=15, help="seconds to gather requests before a publish")
    ap.add_argument("--every", type=float, default=0, help="also publish after this many idle seconds (0: never)")
    args = ap.parse_args()

    requests = queue.Queue()
    threading.Thread(target=listen, args=(args.mqtt, requests), daemon=True).start()
    later = deque()  # requests taken while gathering that need a run of their own
    while True:
        if later:
            first = later.popleft()
        else:
            try:
                first = requests.get(timeout=args.every or None)
            except queue.Empty:
                log(f"nothing asked for {args.every:g}s; publishing anyway")
                first = (None, [])
        ids, argv = [first[0]], first[1]
        if not argv:
            # A plain publish serves every plain request that arrives while
            # things settle; the rest (--dry-run, verify, orphans) run alone.
            end = time.time() + args.settle
            while (left := end - time.time()) > 0:
                try:
                    r = requests.get(timeout=left)
                except queue.Empty:
                    break
                (ids.append(r[0]) if not r[1] else later.append(r))
        code, err, out, secs = publish(argv)
        ok = code == 0
        stamp = datetime.now(timezone.utc).isoformat(timespec="seconds")
        what = " ".join(["publish", *argv])
        log(f"{what} {'done' if ok else 'failed: ' + str(err)} in {secs:.0f}s for {len(ids)} request(s)")
        for i in ids:
            if i is not None:
                answer(args.mqtt, f"{REPLY_TOPIC}/{i}", {"ok": ok, "code": code, "error": err, "stamp": stamp,
                                                         "seconds": round(secs), "output": out})
        if not argv:
            status = {"ok": ok, "error": err, "stamp": stamp, "seconds": round(secs),
                      "host": socket.gethostname()}
            answer(args.mqtt, STATUS_TOPIC, status, retain=True)
            if ok:  # what a staleness alert watches
                answer(args.mqtt, STATUS_TOPIC + "/ok", status, retain=True)


if __name__ == "__main__":
    sys.exit(main())
