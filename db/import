#!/usr/bin/env python3
"""Import a GPX run end to end.

    ./import some/run.gpx 688 -m "Light Maliko"

Filters the GPX with gpxconvert/gpx_filter.py, runs import.sql (via
import.sh) with the foil set to whichever known foil matches the second
argument, then `jj commit` and `jj here main` in this repo.  Pass
--push to finish with `jj push`.

gpx_filter.py runs in gpxconvert's nix dev shell and import.sh in db's,
so their tools are present wherever this is run from.

Known foils come from the SET VARIABLE foil lines in import.sql
(commented out or not) and the foil column of web/src/data/runs.csv.
A foil argument matches when it's a case-insensitive substring of a
foil name; it has to pick out exactly one.
"""

import argparse
import csv
import os
import re
import shutil
import subprocess
import sys
import tempfile

DB_DIR = os.path.dirname(os.path.abspath(__file__))
REPO_DIR = os.path.dirname(DB_DIR)
IMPORT_SQL = os.path.join(DB_DIR, "import.sql")
RUNS_CSV = os.path.join(REPO_DIR, "web", "src", "data", "runs.csv")
GPX_DIR = os.path.join(DB_DIR, "gpxconvert")
GPX_FILTER = os.path.join(GPX_DIR, "gpx_filter.py")

FOIL_RE = re.compile(r"^\s*(--\s*)?SET VARIABLE foil\s*=\s*'([^']*)'\s*;", re.M)
CSV_PATH_RE = re.compile(r"^(\s*SET VARIABLE csv_path\s*=\s*)'[^']*'", re.M)


def die(msg):
    print(f"import: {msg}", file=sys.stderr)
    sys.exit(1)


def known_foils():
    with open(IMPORT_SQL) as f:
        foils = {m.group(2) for m in FOIL_RE.finditer(f.read())}
    try:
        with open(RUNS_CSV, newline="") as f:
            foils |= {r["foil"] for r in csv.DictReader(f) if r.get("foil")}
    except FileNotFoundError:
        pass
    return sorted(foils)


def pick_foil(query, foils):
    q = query.strip().lower()
    exact = [f for f in foils if f.lower() == q]
    if exact:
        return exact[0]
    matches = [f for f in foils if q in f.lower()]
    if len(matches) == 1:
        return matches[0]
    if not matches:
        die(f"no foil matches {query!r}. Known foils:\n  " + "\n  ".join(foils))
    die(f"{query!r} matches more than one foil:\n  " + "\n  ".join(matches))


def import_sql_for(foil, csv_path):
    """import.sql with the foil and CSV path swapped in."""
    with open(IMPORT_SQL) as f:
        sql = f.read()
    if not FOIL_RE.search(sql):
        die("couldn't find a SET VARIABLE foil line in import.sql")
    if not CSV_PATH_RE.search(sql):
        die("couldn't find a SET VARIABLE csv_path line in import.sql")
    # Comment out whichever foil is active, then set ours ahead of the list.
    sql = re.sub(r"^(\s*)(SET VARIABLE foil\s*=)", r"\1-- \2", sql, flags=re.M)
    first = FOIL_RE.search(sql)
    escaped = foil.replace("'", "''")
    sql = (sql[:first.start()] + f"SET VARIABLE foil = '{escaped}';\n"
           + sql[first.start():])
    return CSV_PATH_RE.sub(lambda m: m.group(1) + "'" + csv_path.replace("'", "''") + "'",
                           sql, count=1)


def in_flake(flake_dir, cmd):
    """Run cmd inside flake_dir's dev shell, so its tools (python3 and
    tzdata for gpx_filter; duckdb and rclone for import.sh) are present.
    Without nix, run it as is and hope they're on PATH."""
    if shutil.which("nix") is None:
        return cmd
    return ["nix", "develop", flake_dir, "--command"] + cmd


def run(cmd, cwd=None, stdin=None):
    print("+ " + " ".join(cmd), file=sys.stderr)
    r = subprocess.run(cmd, cwd=cwd, stdin=stdin)
    if r.returncode != 0:
        die(f"{cmd[0]} failed (exit {r.returncode})")


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("gpx", help="GPX file to import")
    ap.add_argument("foil", help="foil to record, e.g. 688 or 'orca 685'")
    ap.add_argument("-m", "--message", help="jj commit message (prompted for if omitted)")
    ap.add_argument("--push", action="store_true", help="jj push after committing")
    ap.add_argument("-n", "--dry-run", action="store_true",
                    help="show the foil and generated SQL, then stop")
    args = ap.parse_args(argv)

    if not os.path.isfile(args.gpx):
        die(f"no such file: {args.gpx}")
    foil = pick_foil(args.foil, known_foils())
    print(f"Foil: {foil}", file=sys.stderr)

    with tempfile.TemporaryDirectory(prefix="dwp-import-") as tmp:
        csv_path = os.path.join(tmp, "activity.csv")
        sql_path = os.path.join(tmp, "import.sql")
        with open(sql_path, "w") as f:
            f.write(import_sql_for(foil, csv_path))

        if args.dry_run:
            with open(sql_path) as f:
                print(f.read())
            return

        # Ask up front so the rest can run unattended.
        message = args.message
        while not message:
            try:
                message = input("Commit message: ").strip()
            except EOFError:
                die("no commit message")

        run(in_flake(GPX_DIR, ["python3", GPX_FILTER, os.path.abspath(args.gpx),
                               "-o", csv_path]))
        run(in_flake(DB_DIR, [os.path.join(DB_DIR, "import.sh"), sql_path]), cwd=DB_DIR)

    run(["jj", "commit", "-m", message], cwd=REPO_DIR)
    run(["jj", "here", "main"], cwd=REPO_DIR)
    if args.push:
        run(["jj", "push"], cwd=REPO_DIR)
    else:
        print("Committed; run `jj push` when you're ready.", file=sys.stderr)


if __name__ == "__main__":
    main()
