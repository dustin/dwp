#!/usr/bin/env python3
"""Import a GPX run end to end.

    ./add-run some/run.gpx 688
    ./add-run some/run.gpx


Filters the GPX with gpxconvert/gpx_filter.py, runs import.sql against
the lake with DWP_FOIL set to the second argument and DWP_CSV to the
filtered CSV, then runs publish.  Leave the foil out to reuse the
one from the rider's latest run that started at the same beach.

import.sql resolves DWP_FOIL to the one known foil it names (688 means
F4 Hammerhead 688), and fails the import if it names none or several.
For a foil you haven't used before, pass --new-foil and its full name.

The run is Dustin's unless --rider names someone else (the subdomain
their runs are served on, e.g. --rider walter). Foils are matched among
that rider's runs, and the board defaults to the one on their latest run
(--board to set it).

Run it from db's nix dev shell, which has python3, tzdata, duckdb and
rclone.
"""

import argparse
import os
import subprocess
import sys
import tempfile

DB_DIR = os.path.dirname(os.path.abspath(__file__))
LAKE_DIR = os.environ.get("LAKE") or os.path.expanduser("~/stuff/duck")

# Keep __pycache__ out of gpxconvert.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(DB_DIR, "gpxconvert"))
import gpx_filter  # noqa: E402


def die(msg):
    print(f"add-run: {msg}", file=sys.stderr)
    sys.exit(1)


def run(cmd, cwd=None, env=None, stdin=None):
    print("+ " + " ".join(cmd), file=sys.stderr)
    r = subprocess.run(cmd, cwd=cwd, env=env, stdin=stdin)
    if r.returncode != 0:
        die(f"{cmd[0]} failed (exit {r.returncode})")


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("gpx", help="GPX file to import")
    ap.add_argument("foil", nargs="?", default="",
                    help="foil to record, e.g. 688 or 'orca 685' (default: the "
                         "rider's latest from the same start beach)")
    ap.add_argument("--new-foil", action="store_true",
                    help="the foil is new: record its name exactly as given")
    ap.add_argument("--rider", default="dustin",
                    help="whose run this is (default: dustin)")
    ap.add_argument("--board", help="board to record (default: the rider's latest)")
    args = ap.parse_args(argv)
    if args.new_foil and not args.foil:
        die("--new-foil needs the foil's name")

    if not os.path.isfile(args.gpx):
        die(f"no such file: {args.gpx}")

    with tempfile.TemporaryDirectory(prefix="dwp-import-") as tmp:
        csv_path = os.path.join(tmp, "activity.csv")
        gpx_filter.main([args.gpx, "-o", csv_path])
        # import.sql reads these with getenv().
        env = dict(os.environ, DWP_CSV=csv_path, DWP_FOIL=args.foil,
                   DWP_RIDER=args.rider, DWP_BOARD=args.board or "",
                   DWP_NEW_FOIL="1" if args.new_foil else "")
        with open(os.path.join(DB_DIR, "import.sql")) as sql:
            run(["duckdb", "--init", "init.sql"], cwd=LAKE_DIR, env=env, stdin=sql)

    run(["./publish"], cwd=DB_DIR)


if __name__ == "__main__":
    main()
