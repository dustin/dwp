#!/usr/bin/env python3
"""Make the lake's beaches match a KML file (e.g. one exported from Google My Maps).

    ./update-beaches beaches.kml             show what changes, ask, apply
    ./update-beaches beaches.kml --dry-run   just show what would change
    ./update-beaches beaches.kml --yes       apply without asking

Each Placemark is a beach, matched to the lake by name. A beach keeps its id
(runs point at it through dwlist.start_pos and end_pos), so:

  - a known name gets the KML's geometry;
  - a new name whose geometry is exactly a beach the KML no longer names is
    that beach renamed, not a new one;
  - any other new name is a new beach with a fresh id;
  - a beach the KML no longer names is deleted, unless runs start or end
    there, in which case it's left alone and listed.

Region: a beach's KML folder is its region (folders are regions; a beach
moved to another folder changes region). A beach in no folder keeps the
region it has, or if it's new takes --region, else the region of the
nearest beach the lake already has.

Placemarks can be points, lines, polygons or multi-geometries; coordinates
are stored lon/lat as the KML has them. One lake commit. It never creates
or changes tables: beaches must already exist (schema.sql).

Then every run with a track gets its start and end beach again, the
nearest beach to its first and last point as import.sql picks them, so a
new or reshaped beach relabels old runs too. The runs that change are
listed with the beaches; --no-relabel leaves runs alone. Runs entered by
hand (no track) are never touched.

Run it from db's nix dev shell, like add-run.
"""

import argparse
import csv
import os
import sys
import tempfile

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from dwp_publish import duckdb, sql_str, PublishError  # noqa: E402
from kml import placemarks  # noqa: E402


def plan(csv_path, region, relabel):
    """What makes the lake match the KML: (has_region, adds, changes, deletes, kept, runs)."""
    cols = {r["column_name"] for r in duckdb(
        "select column_name from information_schema.columns "
        "where table_catalog = 'lake' and table_name = 'beaches';", json_out=True)}
    if not {"id", "name", "geom"} <= cols:
        raise PublishError("no beaches table with id, name and geom in the lake (see schema.sql)")
    has_region = "region" in cols
    src = kml_src(csv_path)
    # Both sides through ST_AsText, so equal shapes compare equal as text.
    new = duckdb(f"""load spatial;
        select k.name, k.folder, ST_AsText(ST_GeomFromText(k.wkt)) as g,
               {'''(select b.region from beaches b where b.region is not null
                    order by ST_Distance(ST_GeomFromText(k.wkt), b.geom) limit 1)'''
                if has_region else 'null'} as near
        from {src} k;""", json_out=True)
    old = duckdb(f"""load spatial;
        select b.id::varchar as id, b.name, ST_AsText(b.geom) as g,
               {'b.region' if has_region else 'null'} as region,
               (select count(*) from dwlist l where l.start_pos = b.id or l.end_pos = b.id) as runs
        from beaches b;""", json_out=True)

    by_name = {o["name"]: o for o in old}
    gone = {o["name"]: o for o in old if o["name"] not in {n["name"] for n in new}}
    adds, changes = [], []
    for n in new:
        o = by_name.get(n["name"])
        if o is None:
            o = next((g for g in gone.values() if g["g"] == n["g"]), None)
            if o is not None:
                del gone[o["name"]]
        if o is None:
            r = n["folder"] or region or n["near"]
            adds.append(dict(name=n["name"], g=n["g"], region=r if has_region else None))
            continue
        r = (n["folder"] or o["region"]) if has_region else None
        if o["name"] != n["name"] or o["g"] != n["g"] or r != o["region"]:
            changes.append(dict(id=o["id"], name=n["name"], old=o["name"], g=n["g"],
                                moved=o["g"] != n["g"], region=r, old_region=o["region"]))
    deletes = [o for o in gone.values() if not o["runs"]]
    kept = [o for o in gone.values() if o["runs"]]
    runs = relabels(src, [k["name"] for k in kept]) if relabel else []
    return has_region, adds, changes, deletes, kept, runs


def kml_src(path):
    return (f"read_csv({sql_str(path)}, header = true, "
            "columns = {'name': 'VARCHAR', 'folder': 'VARCHAR', 'wkt': 'VARCHAR'})")


# Each tracked run's first and last point, and the beach nearest each
# (by the same measure as import.sql) among the beaches in {f}.
ENDS = """ends as (
    select dwid, arg_min(lat, ts) as lat0, arg_min(lon, ts) as lon0,
           arg_max(lat, ts) as lat1, arg_max(lon, ts) as lon1
    from dws group by dwid),
near as (
    select e.dwid,
        (select f.{key} from {f} f order by ST_Length(ST_ShortestLine(
            ST_Point(e.lat0, e.lon0), ST_FlipCoordinates(f.geom))) limit 1) as s,
        (select f.{key} from {f} f order by ST_Length(ST_ShortestLine(
            ST_Point(e.lat1, e.lon1), ST_FlipCoordinates(f.geom))) limit 1) as e
    from ends e)"""


def relabels(src, kept):
    """Runs whose start or end beach the KML's beaches (plus kept) would change."""
    keep = ", ".join(sql_str(k) for k in kept) or "null"
    return duckdb(f"""load spatial;
        with f as (
            select name, ST_GeomFromText(wkt) as geom from {src}
            union all select name, geom from beaches where name in ({keep})),
        {ENDS.format(f="f", key="name")}
        select l.rider, l.date::varchar as date, l.time::varchar as time,
               bs.name as s0, n.s as s1, be.name as e0, n.e as e1
        from near n join dwlist l on l.id = n.dwid
        left join beaches bs on bs.id = l.start_pos
        left join beaches be on be.id = l.end_pos
        where bs.name is distinct from n.s or be.name is distinct from n.e
        order by l.date, l.time;""", json_out=True)


def show(has_region, adds, changes, deletes, kept, runs):
    def reg(r):
        return f" [{r or 'no region'}]" if has_region else ""
    for a in adds:
        print(f"+ {a['name']}{reg(a['region'])}")
    for c in changes:
        what = [f"renamed from {c['old']}"] if c["old"] != c["name"] else []
        what += ["new shape"] if c["moved"] else []
        what += [f"region {c['old_region'] or 'none'} -> {c['region']}"] if c["region"] != c["old_region"] else []
        print(f"~ {c['name']}: {', '.join(what)}")
    for d in deletes:
        print(f"- {d['name']}")
    for k in kept:
        print(f"! {k['name']}: not in the KML, but {k['runs']} run(s) use it; left in the lake")
    if not (adds or changes or deletes):
        print("beaches already match the KML")
    for r in runs:
        moves = [f"{w} {a or 'none'} -> {b}" for w, a, b in
                 (("start", r["s0"], r["s1"]), ("end", r["e0"], r["e1"])) if a != b]
        print(f"> {r['rider']} {r['date']} {r['time'][:5]}: {', '.join(moves)}")
    if runs:
        print(f"{len(runs)} run(s) relabeled")


def apply(has_region, adds, changes, deletes, runs, tmp):
    path = os.path.join(tmp, "apply.csv")
    with open(path, "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(["op", "id", "name", "wkt", "region"])
        for a in adds:
            w.writerow(["add", "", a["name"], a["g"], a["region"] or ""])
        for c in changes:
            w.writerow(["change", c["id"], c["name"], c["g"], c["region"] or ""])
        for d in deletes:
            w.writerow(["delete", d["id"], d["name"], "", ""])
    src = (f"read_csv({sql_str(path)}, header = true, "
           "columns = {'op': 'VARCHAR', 'id': 'VARCHAR', 'name': 'VARCHAR', "
           "'wkt': 'VARCHAR', 'region': 'VARCHAR'})")
    region = ", nullif(region, '') as region" if has_region else ""
    set_region = ", region = nullif(x.region, '')" if has_region else ""
    # After the beaches change, in the same commit: the same pick as
    # relabels(), now by id against the updated table.
    relabel = f"""
        update dwlist as l set start_pos = x.s, end_pos = x.e
        from (with {ENDS.format(f="beaches", key="id")} select * from near) x
        where l.id = x.dwid and (l.start_pos is distinct from x.s or l.end_pos is distinct from x.e);""" if runs else ""
    duckdb(f"""load spatial;
        begin;
        call lake.set_commit_message('dustin', 'beaches from KML');
        update beaches as b set name = x.name, geom = ST_GeomFromText(x.wkt){set_region}
        from (select * from {src} where op = 'change') x
        where b.id = x.id::uuid;
        insert into beaches by name
        select uuid() as id, name, ST_GeomFromText(wkt) as geom{region}
        from {src} where op = 'add';
        delete from beaches where id in (select id::uuid from {src} where op = 'delete');{relabel}
        commit;""")


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("kml", help="the beaches KML")
    ap.add_argument("--region", help="region for new beaches in no KML folder "
                                     "(default: the nearest known beach's)")
    ap.add_argument("--no-relabel", action="store_true",
                    help="don't recompute old runs' start and end beaches")
    ap.add_argument("--dry-run", action="store_true", help="show the changes and stop")
    ap.add_argument("--yes", action="store_true", help="apply without asking")
    a = ap.parse_args(argv)

    try:
        marks = placemarks(a.kml)
    except ValueError as e:
        sys.exit(f"update-beaches: {e}")
    try:
        with tempfile.TemporaryDirectory(prefix="dwp-beaches-") as tmp:
            kml_csv = os.path.join(tmp, "kml.csv")
            with open(kml_csv, "w", newline="") as f:
                w = csv.writer(f)
                w.writerow(["name", "folder", "wkt"])
                w.writerows(marks)
            has_region, adds, changes, deletes, kept, runs = p = plan(kml_csv, a.region, not a.no_relabel)
            show(*p)
            if a.dry_run or not (adds or changes or deletes or runs):
                return 0
            if not a.yes:
                if input("apply? [y/N] ").strip().lower() not in ("y", "yes"):
                    return 1
            apply(has_region, adds, changes, deletes, runs, tmp)
            print(f"{len(adds)} added, {len(changes)} changed, {len(deletes)} deleted, "
                  f"{len(runs)} run(s) relabeled")
    except PublishError as e:
        print(f"update-beaches: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
